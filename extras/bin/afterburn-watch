#!/bin/bash
# afterburn-watch: keeps Afterburn in step with the machine and the sky.
# Long-running user service (extras/afterburn-watch.service). Acts only while
# the active theme is afterburn or an afterburn colour edition. Three loops, one per concern:
#   fullscreen  Hyprland socket2 events      -> afterburn quiet on|off
#   power       bounded 5s poll             -> afterburn saver on|off (battery = on)
#   heat        every 60s                    -> afterburn level cool|normal|hot
# Calls happen only on change. Needs bash, awk, jq, curl, socat.
set -u
export PATH="$HOME/.local/bin:$PATH"   # systemd's PATH may lack ~/.local/bin

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/afterburn/afterburn.conf
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/afterburn
THEME_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme.name
WEATHER=$STATE/weather.json
PSI_FILE=${PSI_FILE:-/proc/pressure/cpu}          # overridable for tests
POWER_DIR=${POWER_DIR:-/sys/class/power_supply}   # overridable for tests
UA='afterburn-theme (github.com/silverwulf212/omarchy-afterburn-theme)'
LEVELS=(cool normal hot)
# shellcheck disable=SC1091
. "$HOME/.config/omarchy/themes/afterburn/extras/afterburn-theme.sh"

# Defaults first, so a missing or partial conf still leaves every value set.
load_conf() {
  ab_load_conf "$(ab_theme_name)"
}

# True for the base theme and for the colour editions (afterburn-voltage, -cyber, ...).
is_afterburn() { local t; t=$(cat "$THEME_FILE" 2>/dev/null); [[ $t == afterburn || $t == afterburn-* ]]; }

# --- fullscreen: quiet while a window is fullscreen --------------------------
# At start, quiet follows what is on screen now. A fullscreen toggle missed while the
# watcher was stopped would otherwise leave quiet stuck on (or off) until the next toggle.
sync_quiet() {
  is_afterburn || return 0
  ab_refresh_instance
  load_conf
  local fs
  fs=$(hyprctl activewindow -j 2>/dev/null | jq -r '.fullscreen // 0' 2>/dev/null)
  if [[ $FULLSCREEN_QUIET == yes ]] && (( ${fs:-0} > 0 )); then
    afterburn quiet on
  else
    afterburn quiet off
  fi
}

# Re-select the socket on every connection attempt. Match the current Wayland
# display after a restart; never fall through to an arbitrary other session.
ab_socket_exists() { [[ -S $1 ]]; }
fullscreen_socket() {
  ab_refresh_instance
  local runtime=${XDG_RUNTIME_DIR:-/run/user/$UID} sig=${HYPRLAND_INSTANCE_SIGNATURE:-} selected
  if [[ -n $sig ]] && ab_socket_exists "$runtime/hypr/$sig/.socket2.sock"; then
    printf '%s\n' "$runtime/hypr/$sig/.socket2.sock"; return 0
  fi
  [[ -n ${WAYLAND_DISPLAY:-} ]] || return 1
  selected=$(hyprctl instances -j 2>/dev/null | jq -r --arg display "$WAYLAND_DISPLAY" '[.[] | select(.wl_socket == $display)] | if length == 1 then .[0].instance else empty end') || return 1
  [[ $selected =~ ^[A-Za-z0-9_.-]+$ ]] && ab_socket_exists "$runtime/hypr/$selected/.socket2.sock" || return 1
  printf '%s\n' "$runtime/hypr/$selected/.socket2.sock"
}
watch_fullscreen() {
  local sock line
  while :; do
    if sock=$(fullscreen_socket); then
      socat -d -d -U - "UNIX-CONNECT:$sock" 2> >(
        while IFS= read -r diagnostic; do
          if [[ $diagnostic == *"starting data transfer loop"* ]]; then
            # Mark ready only after a real connection and fullscreen resync.
            sync_quiet && printf '%s\n' "$sock" | ab_atomic_write "$STATE/fullscreen-socket"
          fi
        done
        rm -f "$STATE/fullscreen-socket"
      ) | while IFS= read -r line; do
        load_conf
        is_afterburn && [[ $FULLSCREEN_QUIET == yes ]] || continue
        case $line in
          'fullscreen>>1') afterburn quiet on ;;
          'fullscreen>>0') afterburn quiet off ;;
        esac
      done
      rm -f "$STATE/fullscreen-socket"
    fi
    sleep 5
  done
}

# --- power: battery means saver mode -----------------------------------------
power_tick() {
  load_conf
  is_afterburn || return 0
  local want actual
  # Compare with persisted state: a CLI override can change it between ticks.
  want=$(ab_saver_want "$LAPTOP_MODE")
  actual=$(cat "$STATE/saver" 2>/dev/null || echo off)
  if [[ $want != "$actual" ]]; then afterburn saver "$want"; fi
  if [[ $FULLSCREEN_QUIET != yes && $(cat "$STATE/quiet" 2>/dev/null) == on ]]; then
    afterburn quiet off
  fi
}

watch_power() {
  while :; do
    power_tick
    # A long-lived upower monitor never wakes for a config edit. Polling sysfs
    # also works without upower and bounds policy-change latency to five seconds.
    sleep 5
  done
}

# --- heat: the level, from time, CPU pressure or weather ---------------------
time_level() {  # cool inside EVENING_HOURS (e.g. 19-07 wraps midnight)
  local s e h=$((10#$(date +%H))) inside=0
  IFS=- read -r s e <<<"$EVENING_HOURS"
  s=$((10#$s)); e=$((10#$e))
  if (( s <= e )); then (( h >= s && h < e )) && inside=1
  else (( h >= s || h < e )) && inside=1; fi
  (( inside )) && echo cool || echo normal
}

pressure_level() {  # CPU pressure avg10 (PSI): <5 cool, 5-35 normal, >35 hot
  local avg
  avg=$(awk '/^some/ { sub("avg10=", "", $2); print $2 }' "$PSI_FILE" 2>/dev/null)
  [[ -n $avg ]] || return 1
  awk -v a="$avg" 'BEGIN { print (a < 5) ? "cool" : (a > 35) ? "hot" : "normal" }'
}

fetch_weather() {  # NWS: points -> first station -> latest obs; forecastHourly for day/night
  local now pts sid obs hr sample
  now=$(date +%s); mkdir -p "$STATE"
  printf '%s\n' "$now" | ab_atomic_write "$STATE/weather-attempt"
  get() { curl -fsS -m 15 -H "User-Agent: $UA" -H 'Accept: application/geo+json' "$1"; }
  pts=$(get "https://api.weather.gov/points/$LAT,$LON") &&
  sid=$(get "$(jq -r '.properties.observationStations' <<<"$pts")" |
        jq -r '(.observationStations[0] // .features[0].properties.stationIdentifier // empty) | split("/") | last') &&
  obs=$(get "https://api.weather.gov/stations/$sid/observations/latest") &&
  hr=$(get "$(jq -r '.properties.forecastHourly' <<<"$pts")") &&
  sample=$(jq -n --argjson now "$now" --argjson obs "$obs" --argjson hr "$hr" '{
    checked: $now,
    tempF: ($obs.properties.temperature.value | if . == null then null else . * 9 / 5 + 32 end),
    text: ($obs.properties.textDescription // ""),
    night: ($hr.properties.periods[0].isDaytime == false)
  }') && printf '%s\n' "$sample" | ab_atomic_write "$WEATHER" && { rm -f "$STATE/weather-error"; return 0; }
  # failed: store only the attempt time, so we retry in 20 min and keep the last level
  printf '%s: weather refresh failed\n' "$(date -u +%FT%TZ)" | ab_atomic_write "$STATE/weather-error"
  return 1
}

weather_level() {  # cached NWS data -> level; no data means no change
  local now checked f txt night i
  now=$(date +%s)
  checked=$(cat "$STATE/weather-attempt" 2>/dev/null || echo 0)
  [[ $checked =~ ^[0-9]+$ ]] || checked=0
  (( now - checked >= 1200 )) && fetch_weather
  f=$(jq -r '.tempF // empty' "$WEATHER" 2>/dev/null)
  [[ -n $f ]] || return 1
  txt=$(jq -r '.text // "" | ascii_downcase' "$WEATHER")
  night=$(jq -r '.night' "$WEATHER")
  i=$(awk -v t="$f" -v h="$HOT_F" -v c="$COOL_F" 'BEGIN { print (t >= h) ? 2 : (t <= c) ? 0 : 1 }')
  [[ $txt =~ rain|drizzle|shower|snow|thunder ]] && i=0
  [[ $night == true && $i -gt 0 ]] && i=$((i - 1))
  echo "${LEVELS[i]}"
}

heat_level() {  # prints cool|normal|hot, or nothing when off or no data
  case $HEAT_SOURCE in
    time) time_level ;;
    pressure) pressure_level ;;
    weather) weather_level ;;
  esac
}

watch_heat() {
  local applied="" prev="" cand
  while :; do
    load_conf
    if is_afterburn; then
      cand=$(heat_level)
      # pressure is jumpy: switch only after two equal readings in a row
      if [[ -n $cand && $cand != "$applied" ]] && { [[ $HEAT_SOURCE != pressure || $cand == "$prev" ]]; }; then
        afterburn level "$cand" && applied=$cand
      fi
      prev=$cand
    fi
    sleep 60
  done
}

main() {
  trap 'trap - EXIT TERM INT; kill 0' EXIT TERM INT   # stop all three loops together
  sync_quiet
  watch_fullscreen &
  watch_power &
  watch_heat &
  wait
}

[[ ${BASH_SOURCE[0]} == "$0" ]] && main "$@"
