#!/bin/bash
# Afterburn extras: an Omarchy theme-set hook, installed by extras/install.sh.
# On afterburn or an edition (afterburn-voltage, -cyber, -overdrive, -redline, -phantom): switch
# Ghostty cursor-fx to embers (if installed), regenerate and reload the glow with `afterburn apply`
# (Omarchy drops a cloned theme's .lua) in the edition's colours, recolour the lock-screen embers,
# and (re)start the watcher.
# On any other theme: stop the watcher, put the previous cursor-fx effect back, and put the lock
# embers back to the base orange.
set -u
THEME="${1:-}"
EXTRAS="$HOME/.config/omarchy/themes/afterburn/extras"
CURRENT="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/afterburn/prev-cursor-fx"
# Written by `afterburn quiet|saver` while they hold the cursor effect off. Not the user's own effect.
PRE_QUIET="$(dirname "$STATE")/cursor-pre-quiet"
GHOSTTY="$HOME/.config/ghostty/config"
LOCK_SH="$EXTRAS/lock/lock-embers.sh"
LOCK_MARK="${XDG_STATE_HOME:-$HOME/.local/state}/afterburn/lock-embers"
AFTERBURN="$(command -v afterburn 2>/dev/null || echo "$HOME/.local/bin/afterburn")"

cursor_now() { grep -oP '^config-file\s*=\s*\??cursor-effects/\K[^.]+' "$GHOSTTY" 2>/dev/null || echo off; }

# The colour helpers live in the base theme's extras. Without them, only the base theme is known.
if [[ -f $EXTRAS/afterburn-theme.sh ]]; then
  # shellcheck disable=SC1091
  . "$EXTRAS/afterburn-theme.sh"
else
  ab_is_afterburn() { [[ ${1:-} == afterburn ]]; }
fi

if ab_is_afterburn "$THEME"; then
  if declare -F ab_load_palette >/dev/null; then
    ab_load_palette "$THEME"
    ab_write_palette_env || true
    # Lock embers follow the theme (only when the installer put the embers there).
    if [[ -f $LOCK_MARK && -f $LOCK_SH ]]; then
      bash "$LOCK_SH" recolor "$AB_FLARE" "$AB_EMBER" "$AB_RUST" >/dev/null 2>&1 || true
    fi
  fi
  # Cursor first: afterburn apply may put cursor-fx off in quiet mode, and must see the saved previous effect.
  if command -v cursor-fx >/dev/null; then
    cur=$(cursor_now)
    if [[ $cur != embers ]]; then
      # Fullscreen or battery may have switched the effect off for now: that is not your own effect, keep the saved one.
      [[ -f $PRE_QUIET ]] || { mkdir -p "$(dirname "$STATE")" && echo "$cur" > "$STATE"; }
      cursor-fx embers >/dev/null 2>&1 || true
    fi
  fi
  if [[ -x $AFTERBURN ]]; then
    "$AFTERBURN" apply >/dev/null 2>&1 || true
  elif [[ -f $EXTRAS/hyprland-glow.lua && -d $CURRENT ]]; then
    # No CLI: the plain glow, recoloured for an edition the same way `afterburn apply` does.
    if declare -F ab_load_palette >/dev/null; then
      ab_recolor_glow "$EXTRAS/hyprland-glow.lua" > "$CURRENT/hyprland.lua"
    else
      cp "$EXTRAS/hyprland-glow.lua" "$CURRENT/hyprland.lua"
    fi
    hyprctl reload >/dev/null 2>&1 || true
  fi
  systemctl --user restart afterburn-watch.service >/dev/null 2>&1 || true
else
  systemctl --user stop afterburn-watch.service >/dev/null 2>&1 || true
  if [[ -f $STATE ]] && command -v cursor-fx >/dev/null; then
    cursor-fx "$(cat "$STATE")" >/dev/null 2>&1 || true
    rm -f "$STATE"
  fi
  # Drop the fullscreen and battery flags: the watcher is stopped, so it can't clear them later.
  rm -f "$(dirname "$STATE")/quiet" "$(dirname "$STATE")/saver" "$PRE_QUIET"
  # Back to the base palette for the fail flash and the lock embers.
  rm -f "$(dirname "$STATE")/palette.env"
  if [[ -f $LOCK_MARK && -f $LOCK_SH ]]; then bash "$LOCK_SH" recolor >/dev/null 2>&1 || true; fi
fi
exit 0
