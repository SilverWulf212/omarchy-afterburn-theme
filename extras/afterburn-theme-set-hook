#!/bin/bash
# Afterburn extras: an Omarchy theme-set hook, installed by extras/install.sh.
# On afterburn or an edition (afterburn-<name>, one per folder in .editions/): switch
# Ghostty cursor-fx to the theme's effect (CURSOR_FX: your afterburn.conf, else the edition's
# edition.conf, else embers; if installed), regenerate and reload the glow with `afterburn apply`
# (Omarchy drops a cloned theme's .lua) in the edition's colours, recolour the lock-screen embers
# and give them the edition's motion (EMBER_STYLE), and (re)start the watcher.
# On any other theme: stop the watcher, put the previous cursor-fx effect back, put the lock
# embers back to the base orange and the rising motion, and make Omarchy's own lock the active
# one again (lock-embers.sh park; coming back to Afterburn unparks it).
set -u
THEME="${1:-}"
EXTRAS="$HOME/.config/omarchy/themes/afterburn/extras"
CURRENT="$HOME/.local/state/omarchy/current/theme"
# Quick theme switches start several hooks, which run detached. A run for a theme that is no longer the
# current one changes nothing: checked at the start and again before every step that changes something,
# since the lock-screen steps can wait for one another.
still_current() { [[ $THEME == "$(cat "$CURRENT.name" 2>/dev/null)" ]]; }
still_current || exit 0
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/afterburn"
STATE="$STATE_DIR/prev-cursor-fx"
# Written by `afterburn quiet` only while it holds the cursor effect off (saver leaves the effect running).
# Not the user's own effect.
PRE_QUIET="$STATE_DIR/cursor-pre-quiet"
# The effect this hook (or `afterburn set CURSOR_FX`) last switched on. Moving from one edition to the
# next must not mistake it for your own effect and save it as the one to restore.
OURS_FX="$STATE_DIR/cursor-fx-set"
# dark|light of the Afterburn theme this hook last set. cursor-fx reads the terminal background only
# when it switches effects, so going dark -> light (or back) has to switch even if the effect is the same.
FX_MODE="$STATE_DIR/cursor-fx-mode"
# Written by an older `afterburn saver on` when it turned `cursor-fx subtle` on from off. Not the user's own setting.
SUBTLE_REC="$STATE_DIR/subtle-by-afterburn"
GHOSTTY=${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config; [[ -e $GHOSTTY ]] || GHOSTTY+=.ghostty
LOCK_SH="$EXTRAS/lock/lock-embers.sh"
LOCK_MARK="$STATE_DIR/lock-embers"
# Our CLI only: the installer links it into ~/.local/bin. Another program called `afterburn` on your PATH (the
# installer skips the subtle pack when it finds one) is never run.
AFTERBURN="$HOME/.local/bin/afterburn"
[[ -x $AFTERBURN && $(readlink -f "$AFTERBURN") == "$(readlink -f "$EXTRAS/bin/afterburn")" ]] || AFTERBURN=""

cursor_now() {
  if declare -F ab_cursor_now >/dev/null; then ab_cursor_now
  else grep -oP '^\s*config-file\s*=\s*\??"?\??cursor-effects/\K[^."/]+' "$GHOSTTY" 2>/dev/null | tail -n1 | grep . || echo off; fi
}

# The colour helpers live in the base theme's extras. Without them, only the base theme is known.
if [[ -f $EXTRAS/afterburn-theme.sh ]]; then
  # shellcheck disable=SC1091
  . "$EXTRAS/afterburn-theme.sh"
else
  ab_is_afterburn() { [[ ${1:-} == afterburn ]]; }
fi
# Savepoints left in ~/ghostty-savepoints by an older Afterburn or a manual cursor-fx move out of your home folder.
declare -F ab_move_savepoints >/dev/null && ab_move_savepoints

if ab_is_afterburn "$THEME"; then
  # The edition's knobs: your afterburn.conf first, then its edition.conf, then the base default.
  WANT_FX=embers WANT_STYLE=rise
  # The ember lock comes back if leaving Afterburn parked it (and you have not picked another lock since).
  if [[ -f $LOCK_MARK && -f $LOCK_SH ]]; then LOCK_EMBERS_FOR_THEME="$THEME" bash "$LOCK_SH" unpark >/dev/null 2>&1 || true; fi
  if declare -F ab_effective >/dev/null; then
    ab_effective CURSOR_FX "$THEME" 2>/dev/null; WANT_FX=$AB_VAL
    ab_effective EMBER_STYLE "$THEME" 2>/dev/null; WANT_STYLE=$AB_VAL
  fi
  if declare -F ab_load_palette >/dev/null; then
    ab_load_palette "$THEME"
    ab_write_palette_env || true
    # Lock embers follow the theme (only when the installer put the embers there).
    if [[ -f $LOCK_MARK && -f $LOCK_SH ]]; then
      LOCK_EMBERS_FOR_THEME="$THEME" bash "$LOCK_SH" recolor "$AB_FLARE" "$AB_EMBER" "$AB_RUST" "$WANT_STYLE" >/dev/null 2>&1 || true
    fi
  fi
  still_current || exit 0
  # The red prompt symbol, if you chose it at install (a no-op when it is already there).
  declare -F ab_starship_apply >/dev/null && { ab_starship_apply || true; }
  still_current || exit 0
  # Cursor first: afterburn apply may put cursor-fx off in quiet mode, and must see the saved previous effect.
  if command -v cursor-fx >/dev/null; then
    cur=$(cursor_now)
    ours=$(cat "$OURS_FX" 2>/dev/null || true)
    # An install from before editions had their own effect set embers and wrote no record of it. If an
    # effect is saved and embers is running, that embers is ours: do not save it over your own.
    if [[ -z $ours && -f $STATE && $cur == embers ]]; then ours=embers; fi
    fx_ok=0
    if [[ -f $PRE_QUIET ]]; then
      # Fullscreen has the effect off for now. Leave it off, and make the one that comes back
      # afterwards this theme's. What was saved is not your own effect, so it is not touched either.
      echo "$WANT_FX" > "$PRE_QUIET" && fx_ok=1
    else
      # Save the effect to restore later, unless the current one is only the previous Afterburn theme's.
      # Also when it is the very effect this theme wants: it is still yours, and the next edition may
      # switch it, so leaving Afterburn has to know it.
      if [[ -z $ours || $cur != "$ours" ]]; then
        mkdir -p "$STATE_DIR" && echo "$cur" > "$STATE"
      fi
      was_mode=$(cat "$FX_MODE" 2>/dev/null || echo dark)
      if [[ $cur == "$WANT_FX" && $was_mode == "${AB_MODE:-dark}" ]] || cursor-fx "$WANT_FX" >/dev/null 2>&1; then
        fx_ok=1
      fi
    fi
    # Recorded as ours only once it is on: a failed switch leaves the record of what is really running.
    if (( fx_ok )); then
      mkdir -p "$STATE_DIR" && echo "$WANT_FX" > "$OURS_FX" && echo "${AB_MODE:-dark}" > "$FX_MODE"
    fi
  fi
  still_current || exit 0
  if [[ -n $AFTERBURN ]]; then
    "$AFTERBURN" apply >/dev/null 2>&1 || true
  elif [[ -f $EXTRAS/hyprland-glow.lua && -d $CURRENT ]]; then
    # No CLI: the plain glow, recoloured for an edition the same way `afterburn apply` does.
    if declare -F ab_load_palette >/dev/null; then
      ab_recolor_glow "$EXTRAS/hyprland-glow.lua" > "$CURRENT/hyprland.lua"
    else
      cp "$EXTRAS/hyprland-glow.lua" "$CURRENT/hyprland.lua"
    fi
    hyprctl reload >/dev/null 2>&1 || true
  fi
  still_current || exit 0
  systemctl --user restart afterburn-watch.service >/dev/null 2>&1 || true
else
  systemctl --user stop afterburn-watch.service >/dev/null 2>&1 || true
  # Your effect back, but only over Afterburn's own: one you picked yourself while on Afterburn stays. (Under
  # fullscreen quiet the effect is off for now; the one that would come back is what counts.) A failed restore
  # keeps the records, so the next switch away tries again.
  if [[ -f $STATE ]] && command -v cursor-fx >/dev/null; then
    cur=$(cursor_now)
    [[ -f $PRE_QUIET ]] && cur=$(cat "$PRE_QUIET")
    ours=$(cat "$OURS_FX" 2>/dev/null || true)
    if [[ -n $ours && $cur != "$ours" ]]; then
      rm -f "$STATE"
    elif cursor-fx "$(cat "$STATE")" >/dev/null 2>&1; then
      rm -f "$STATE"
    fi
  fi
  [[ -f $STATE ]] || rm -f "$OURS_FX" "$FX_MODE"
  # Battery saver turned subtle on: it goes back off now (a subtle you had on yourself has no record and stays).
  if [[ -f $SUBTLE_REC ]] && command -v cursor-fx >/dev/null; then
    cursor-fx subtle off >/dev/null 2>&1 || true
  fi
  rm -f "$SUBTLE_REC"
  # Battery saver's no-animation line is Afterburn's: other themes animate as you set Ghostty up.
  declare -F ab_ghostty_still >/dev/null && ab_ghostty_still off
  # Drop the fullscreen and battery flags: the watcher is stopped, so it can't clear them later.
  rm -f "$STATE_DIR/quiet" "$STATE_DIR/saver" "$PRE_QUIET"
  still_current || exit 0
  # Your own prompt symbol on other themes.
  declare -F ab_starship_restore >/dev/null && { ab_starship_restore || true; }
  # Back to the base palette for the fail flash and the lock embers.
  rm -f "$STATE_DIR/palette.env"
  # The ember lock is Afterburn's: other themes get Omarchy's own lock screen back until you return.
  if [[ -f $LOCK_MARK && -f $LOCK_SH ]]; then
    LOCK_EMBERS_FOR_THEME="$THEME" bash "$LOCK_SH" recolor >/dev/null 2>&1 || true
    LOCK_EMBERS_FOR_THEME="$THEME" bash "$LOCK_SH" park >/dev/null 2>&1 || true
  fi
fi
exit 0
