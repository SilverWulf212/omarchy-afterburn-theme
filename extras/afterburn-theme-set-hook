#!/bin/bash
# Afterburn extras: an Omarchy theme-set hook, installed by extras/install.sh.
# On afterburn or an edition (afterburn-voltage, -cyber, -overdrive, -redline, -phantom): switch
# Ghostty cursor-fx to the theme's effect (CURSOR_FX: your afterburn.conf, else the edition's
# edition.conf, else embers; if installed), regenerate and reload the glow with `afterburn apply`
# (Omarchy drops a cloned theme's .lua) in the edition's colours, recolour the lock-screen embers
# and give them the edition's motion (EMBER_STYLE), and (re)start the watcher.
# On any other theme: stop the watcher, put the previous cursor-fx effect back, and put the lock
# embers back to the base orange and the rising motion.
set -u
THEME="${1:-}"
EXTRAS="$HOME/.config/omarchy/themes/afterburn/extras"
CURRENT="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/afterburn/prev-cursor-fx"
# Written by `afterburn quiet|saver` while they hold the cursor effect off. Not the user's own effect.
PRE_QUIET="$(dirname "$STATE")/cursor-pre-quiet"
# The effect this hook (or `afterburn set CURSOR_FX`) last switched on. Moving from one edition to the
# next must not mistake it for your own effect and save it as the one to restore.
OURS_FX="$(dirname "$STATE")/cursor-fx-set"
# Written by `afterburn saver on` when it turned `cursor-fx subtle` on from off. Not the user's own setting.
SUBTLE_REC="$(dirname "$STATE")/subtle-by-afterburn"
GHOSTTY="$HOME/.config/ghostty/config"
LOCK_SH="$EXTRAS/lock/lock-embers.sh"
LOCK_MARK="${XDG_STATE_HOME:-$HOME/.local/state}/afterburn/lock-embers"
AFTERBURN="$(command -v afterburn 2>/dev/null || echo "$HOME/.local/bin/afterburn")"

cursor_now() { grep -oP '^config-file\s*=\s*\??cursor-effects/\K[^.]+' "$GHOSTTY" 2>/dev/null || echo off; }

# The colour helpers live in the base theme's extras. Without them, only the base theme is known.
if [[ -f $EXTRAS/afterburn-theme.sh ]]; then
  # shellcheck disable=SC1091
  . "$EXTRAS/afterburn-theme.sh"
else
  ab_is_afterburn() { [[ ${1:-} == afterburn ]]; }
fi

ab_lock || exit 1
ab_refresh_instance

if ab_is_afterburn "$THEME"; then
  # The edition's knobs: your afterburn.conf first, then its edition.conf, then the base default.
  WANT_FX=embers WANT_STYLE=rise
  if declare -F ab_effective >/dev/null; then
    ab_effective CURSOR_FX "$THEME" 2>/dev/null; WANT_FX=$AB_VAL
    ab_effective EMBER_STYLE "$THEME" 2>/dev/null; WANT_STYLE=$AB_VAL
  fi
  if declare -F ab_load_palette >/dev/null; then
    ab_load_palette "$THEME"
    ab_write_palette_env || exit $?
    # Lock embers follow the theme (only when the installer put the embers there).
    if [[ -f $LOCK_MARK && -f $LOCK_SH ]]; then
      bash "$LOCK_SH" recolor "$AB_FLARE" "$AB_EMBER" "$AB_RUST" "$WANT_STYLE" >/dev/null 2>&1 || exit $?
    fi
  fi
  # Cursor first: afterburn apply may put cursor-fx off in quiet mode, and must see the saved previous effect.
  ab_load_conf "$THEME"
  DESIRED_FX=$WANT_FX
  if ! ab_motion_enabled; then WANT_FX=off; fi
  if command -v cursor-fx >/dev/null; then
    cur=$(cursor_now)
    ours=$(cat "$OURS_FX" 2>/dev/null || true)
    # An install from before editions had their own effect set embers and wrote no record of it. If an
    # effect is saved and embers is running, that embers is ours: do not save it over your own.
    if [[ -z $ours && -f $STATE && $cur == embers ]]; then ours=embers; fi
    if [[ -f $PRE_QUIET ]]; then
      # Fullscreen or battery has the effect off for now. Leave it off, and make the one that comes back
      # afterwards this theme's. What was saved is not your own effect, so it is not touched either.
      printf '%s\n' "$DESIRED_FX" | ab_atomic_write "$PRE_QUIET"
    else
      # Save the effect to restore later, unless the current one is only the previous Afterburn theme's.
      # Also when it is the very effect this theme wants: it is still yours, and the next edition may
      # switch it, so leaving Afterburn has to know it.
      if [[ -z $ours || $cur != "$ours" ]]; then
        mkdir -p "$(dirname "$STATE")" && printf '%s\n' "$cur" | ab_atomic_write "$STATE"
      fi
      if ! ab_motion_enabled; then printf '%s\n' "$DESIRED_FX" | ab_atomic_write "$PRE_QUIET"; fi
      [[ $cur == "$WANT_FX" ]] || ab_run cursor-fx "$WANT_FX" >/dev/null 2>&1 || exit $?
    fi
    mkdir -p "$(dirname "$STATE")" && printf '%s\n' "$WANT_FX" | ab_atomic_write "$OURS_FX"
  fi
  if [[ -x $AFTERBURN ]]; then
    ab_run "$AFTERBURN" apply >/dev/null 2>&1 || exit $?
  elif [[ -f $EXTRAS/hyprland-glow.lua && -d $CURRENT ]]; then
    # No CLI: the plain glow, recoloured for an edition the same way `afterburn apply` does.
    if declare -F ab_load_palette >/dev/null; then
      ab_recolor_glow "$EXTRAS/hyprland-glow.lua" | ab_atomic_write "$CURRENT/hyprland.lua"
    else
      cp "$EXTRAS/hyprland-glow.lua" "$CURRENT/hyprland.lua"
    fi
    ab_run hyprctl reload >/dev/null 2>&1 || exit $?
  fi
  ab_run systemctl --user restart afterburn-watch.service >/dev/null 2>&1 || exit $?
else
  ab_run systemctl --user stop afterburn-watch.service >/dev/null 2>&1 || exit $?
  if [[ -f $STATE ]] && command -v cursor-fx >/dev/null; then
    ab_run cursor-fx "$(cat "$STATE")" >/dev/null 2>&1 || exit $?
    rm -f "$STATE"
  fi
  rm -f "$OURS_FX"
  # Battery saver turned subtle on: it goes back off now (a subtle you had on yourself has no record and stays).
  if [[ -f $SUBTLE_REC ]] && command -v cursor-fx >/dev/null; then
    ab_run cursor-fx subtle off >/dev/null 2>&1 || exit $?
  fi
  rm -f "$SUBTLE_REC"
  # Drop the fullscreen and battery flags: the watcher is stopped, so it can't clear them later.
  rm -f "$(dirname "$STATE")/quiet" "$(dirname "$STATE")/saver" "$PRE_QUIET"
  # Back to the base palette for the fail flash and the lock embers.
  rm -f "$(dirname "$STATE")/palette.env"
  if [[ -f $LOCK_MARK && -f $LOCK_SH ]]; then bash "$LOCK_SH" recolor >/dev/null 2>&1 || exit $?; fi
fi
exit 0
