#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Switch Ghostty cursor effects.

  cursor-fx            list the effects, the active one marked
  cursor-fx <name>     switch to an effect (e.g. lightning, glitch)
  cursor-fx off        plain cursor, no effect
  cursor-fx toggle     off, or back on to the last effect (bind it to a key; see the README)
  cursor-fx enter off  no Enter and done effects (typing effects stay; edits ENTER_EFFECT
  cursor-fx enter on   and DONE_EFFECT in every shader and reloads) ...or play them again
  cursor-fx jumps off  no effect when the cursor jumps along a line (delete-all, Home...)
  cursor-fx jumps on   ...or play the effect (edits JUMP_EFFECTS in every shader and reloads)
  cursor-fx idle off   no small animations between keystrokes (crackle, breath, ping...):
  cursor-fx idle on    a calmer screen (it saves little battery: Ghostty keeps redrawing
                       while any effect is on; `cursor-fx off` is the power saver)
  cursor-fx subtle on  the calm version of every effect for all-day use: smaller, dimmer
  cursor-fx subtle off moments and a quieter cursor (edits SUBTLE in every shader and reloads)
  cursor-fx panes on   Claude Code in herdr or tmux panes: find its input box in the pane and
  cursor-fx panes off  keep the effects there (costs ~1-1.5 ms a frame; on by itself the first
                       time you pick an effect inside herdr)
  cursor-fx edit       open the settings panel in your browser: pick the effect, set its
                       cursor color and every setting of its shader with a live preview;
                       changes apply to Ghostty as you make them (--no-open: just print the URL)
  cursor-fx signal     mark "Enter pressed" for the effects (run by the Claude Code
                       UserPromptSubmit hook and zsh's preexec; --tty PATH to choose the tab)
  cursor-fx signal done   mark "the answer arrived" (Claude Code's Stop hook; zsh after a
                       command that took more than a few seconds)
  cursor-fx --version  the installed version

Each effect is a preset in cursor-effects/<name>.conf next to the Ghostty config that sets
the cursor color and its shader. Switching makes a savepoint, rewrites the one
`config-file = cursor-effects/...` line in the Ghostty config, validates it, and
reloads Ghostty (SIGUSR2, the same as Command+Shift+,) so the effect starts at once.

Works on macOS and Linux (Ghostty has no Windows version): the config is the first
config or config.ghostty in $XDG_CONFIG_HOME/ghostty (~/.config/ghostty), then in
Ghostty's macOS folder, with symlinks followed to the real file; both the macOS app
and the Linux GTK app reload on SIGUSR2.

Test hooks: CURSOR_FX_CONFIG (config path; outside Ghostty's config folders a sandbox:
only that file's own settings and no reload, since the running Ghostty doesn't read it;
inside them a local include of the real config, e.g. for a config kept in dotfiles),
CURSOR_FX_SAVEPOINTS, CURSOR_FX_TTY.
"""
import contextlib
import hashlib
import io
import json
import math
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import threading
import time
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

VERSION = "1.2.0"

def ghostty_folders():
    """The folders Ghostty reads its config from: under $XDG_CONFIG_HOME (default ~/.config) and macOS's."""
    return (os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "ghostty"),
            os.path.expanduser("~/Library/Application Support/com.mitchellh.ghostty"))


def find_config():
    """The Ghostty config file: the first existing config or config.ghostty in the Ghostty folders.
    Symlinks are resolved, so the presets and shaders sit next to the real file."""
    folders = ghostty_folders()
    for folder in folders:
        for name in ("config", "config.ghostty"):
            if os.path.exists(os.path.join(folder, name)):
                return os.path.realpath(os.path.join(folder, name))
    return os.path.join(folders[0], "config")


CONFIG = os.environ.get("CURSOR_FX_CONFIG") or find_config()


def sandboxed():
    """A CURSOR_FX_CONFIG outside Ghostty's folders is a test sandbox, which the running Ghostty never
    reads. One inside them is a local include of the real config, which it does read."""
    folder = os.path.dirname(os.path.realpath(CONFIG))
    return "CURSOR_FX_CONFIG" in os.environ and folder not in map(os.path.realpath, ghostty_folders())


PRESETS = os.path.join(os.path.dirname(CONFIG), "cursor-effects")
THEMES = os.path.join(os.path.dirname(CONFIG), "themes")
SAVEPOINTS = os.environ.get("CURSOR_FX_SAVEPOINTS", os.path.expanduser("~/ghostty-savepoints"))
CACHE = os.environ.get("CURSOR_FX_CACHE", os.path.expanduser("~/.cache/cursor-fx"))
SIGNAL_TIME = 1.9  # seconds the Enter signal stays on (longer than the longest Enter effect)
GHOSTTY_APP = "/Applications/Ghostty.app/Contents/MacOS/ghostty"  # macOS; Linux has `ghostty` on PATH
GHOSTTY = GHOSTTY_APP if os.path.isfile(GHOSTTY_APP) else shutil.which("ghostty")
SHADERS = os.path.join(os.path.dirname(CONFIG), "shaders")
# The on/off settings every shader shares, switched for all of them at once
# (`cursor-fx <flag> on|off`): the constants each one sets, and its name.
FLAGS = {"enter": (("ENTER_EFFECT", "DONE_EFFECT"), "Enter & done effects"),
         "jumps": (("JUMP_EFFECTS",), "Jump effects"), "idle": (("IDLE_EFFECTS",), "Idle animations"),
         "subtle": (("SUBTLE",), "Subtle version")}


def flag_line(flag):
    return re.compile(r'^(const\s+bool\s+(?:' + "|".join(FLAGS[flag][0]) + r')\s*=\s*)(true|false)(\s*;.*)$')

MARKER = "# Cursor effect preset"
MARKER_LINE = MARKER + " from cursor-effects/ (switch with `cursor-fx <name>`, list with `cursor-fx`).\n"
INCLUDE = re.compile(r'^\s*config-file\s*=\s*"?\??cursor-effects/([^"/]+)\.conf"?\s*$')
# Before 1.1, `cursor-fx enter off` left this comment in the config. `signal` still honors it;
# `cursor-fx enter on` removes it (the switch is now ENTER_EFFECT and DONE_EFFECT in every shader).
ENTER_OFF = re.compile(r'^\s*#\s*cursor-fx-enter\s*=\s*off\b')
# Switching an effect off leaves its name in this comment, for `cursor-fx toggle`.
LAST = re.compile(r'^\s*#\s*cursor-fx-last\s*=\s*([A-Za-z0-9_.-]+)')
SETTING = re.compile(r'^\s*([a-z-]+)\s*=\s*(.*?)\s*$')

ROLLBACK = """#!/bin/bash
set -euo pipefail

savepoint_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
(
  cd "$savepoint_dir"
  shasum -a 256 -c SHA256SUMS >/dev/null
)

rescue_dir="$(mktemp -d "$savepoint_dir/pre-rollback.XXXXXX")"
cp -p @CONFIG@ "$rescue_dir/ghostty-config"
cp -p "$savepoint_dir/ghostty-config" @CONFIG@

echo "已恢复 cursor-fx 切换前的 Ghostty 配置（光标特效：@BEFORE@）。"
echo "回滚前的配置另存于：$rescue_dir"
echo "请在 Ghostty 按 Command+Shift+, 重新加载。"
"""


def settings(path):
    """The key = value lines of a Ghostty config file, as a dict (last one wins)."""
    out = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                m = SETTING.match(line)
                if m and not line.lstrip().startswith("#"):
                    out[m.group(1)] = m.group(2).strip('"')
    except OSError:
        pass
    return out


# The order effects are listed in (CLI and panel); any other preset follows, by name.
ORDER = ["cyber", "lightning", "glitch", "neon", "phosphor", "embers", "shockwave", "katana",
         "teleport", "fireworks", "aurora", "mecha", "hologram"]


def presets():
    """(name, description) for every preset file, in ORDER, then the rest by name."""
    found = []
    if os.path.isdir(PRESETS):
        entries = sorted(os.listdir(PRESETS), key=lambda e: (ORDER.index(e[:-5]) if e[:-5] in ORDER else len(ORDER), e))
        for entry in entries:
            if not entry.endswith(".conf"):
                continue
            desc = ""
            with open(os.path.join(PRESETS, entry), encoding="utf-8") as f:
                for line in f:
                    if line.startswith("#"):
                        desc = line.lstrip("# ").strip()
                        desc = desc.split(": ", 1)[1] if ": " in desc else desc
                        break
            found.append((entry[:-5], desc))
    return found


def active(lines):
    for line in lines:
        m = INCLUDE.match(line)
        if m:
            return m.group(1)
    return None


def enter_enabled(lines):
    return not any(ENTER_OFF.match(line) for line in lines)


def enter_paused():
    """Whether the config still has the pause comment of cursor-fx before 1.1."""
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return not enter_enabled(f.readlines())
    except OSError:
        return False


def drop_enter_pause():
    """Remove that comment (`cursor-fx enter on`); True if there was one."""
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    out = [line for line in lines if not ENTER_OFF.match(line)]
    if len(out) == len(lines):
        return False
    with open(CONFIG, "w", encoding="utf-8") as f:
        f.writelines(out)
    return True


def savepoint(label, before):
    stamp = time.strftime("%Y%m%d-%H%M%S")
    sp = os.path.join(SAVEPOINTS, f"{stamp}-before-{label}")
    n = 2
    while os.path.exists(sp):
        sp = os.path.join(SAVEPOINTS, f"{stamp}-{n}-before-{label}")
        n += 1
    os.makedirs(sp)
    copy = os.path.join(sp, "ghostty-config")
    shutil.copy2(CONFIG, copy)
    with open(copy, "rb") as f:
        digest = hashlib.sha256(f.read()).hexdigest()
    with open(os.path.join(sp, "SHA256SUMS"), "w", encoding="utf-8") as f:
        f.write(f"{digest}  ghostty-config\n")
    rollback = os.path.join(sp, "rollback.sh")
    with open(rollback, "w", encoding="utf-8") as f:
        f.write(ROLLBACK.replace("@CONFIG@", shlex.quote(CONFIG)).replace("@BEFORE@", before))
    os.chmod(rollback, 0o755)
    return sp


def reset_cursor_color():
    """Drop a cursor color this tab was given by escape code (OSC 112), so it follows
    the config again. Earlier versions of cursor-fx set one with OSC 12, and such an
    override survives config reloads."""
    tty = os.environ.get("CURSOR_FX_TTY")
    if not tty:
        if os.environ.get("TMUX") or not sys.stdout.isatty():
            return
        tty = "/dev/tty"
    try:
        with open(tty, "w") as f:
            f.write("\033]112\007")
    except OSError:
        pass


def ghostty_pids():
    """The running Ghostty app: the one this command runs in, else any Ghostty app process."""
    pid = os.getpid()
    while pid > 1:
        out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.strip()
        if not out:
            break
        ppid, comm = out.split(None, 1)
        if comm == GHOSTTY or os.path.basename(comm) == "ghostty":  # macOS shows the full path, Linux the name
            return [pid]
        pid = int(ppid)
    if GHOSTTY == GHOSTTY_APP:
        found = subprocess.run(["pgrep", "-f", GHOSTTY], capture_output=True, text=True).stdout.split()
    else:
        found = subprocess.run(["pgrep", "-x", "ghostty"], capture_output=True, text=True).stdout.split()
    apps = []
    for p in found:
        args = subprocess.run(["ps", "-o", "args=", "-p", p], capture_output=True, text=True).stdout.strip()
        if " +" not in args:  # skip CLI runs like `ghostty +show-config`
            apps.append(int(p))
    return apps


def reload_ghostty():
    """Ask Ghostty to reload its config (it handles SIGUSR2 like Command+Shift+,)."""
    if sandboxed():
        return False
    sent = False
    for pid in ghostty_pids():
        try:
            os.kill(pid, signal.SIGUSR2)
            sent = True
        except OSError:
            pass
    return sent


def list_effects():
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    now = active(lines)
    found = presets()
    width = max([len(name) for name, _ in found] + [3])
    print("Cursor effects (switch with: cursor-fx <name>):")
    for name, desc in found + [("off", "plain cursor, no effect")]:
        mark = "●" if name == (now or "off") else " "
        print(f"  {mark} {name.ljust(width)}  {desc}")
    for flag in FLAGS:
        print(f"{FLAGS[flag][1]}: {flag_state(flag)} (cursor-fx {flag} on|off)")
    return 0


def flag_lines(flag):
    """(shader path, lines, indexes of the flag's lines) for every shader that has it."""
    found = []
    pattern = flag_line(flag)
    if os.path.isdir(SHADERS):
        for entry in sorted(os.listdir(SHADERS)):
            if not entry.endswith(".glsl"):
                continue
            path = os.path.join(SHADERS, entry)
            with open(path, encoding="utf-8") as f:
                lines = f.readlines()
            at = [i for i, line in enumerate(lines) if pattern.match(line)]
            if at:
                found.append((path, lines, at))
    return found


def flag_state(flag):
    """on, off, mixed (the shaders differ) or n/a. Enter & done is off while the old pause comment is in the config."""
    if flag == "enter" and enter_paused():
        return "off"
    pattern = flag_line(flag)
    states = {pattern.match(lines[i]).group(2) for _, lines, at in flag_lines(flag) for i in at}
    if not states:
        return "n/a"
    return {"true": "on", "false": "off"}[states.pop()] if len(states) == 1 else "mixed"


def set_flag(flag, state):
    """Turn a shared on/off setting (`cursor-fx enter`, `jumps`, `idle`, `subtle`) on or off in every shader."""
    label = FLAGS[flag][1]
    if state is None:
        print(f"{label}: {flag_state(flag)} (cursor-fx {flag} on|off)")
        return 0
    if state not in ("on", "off"):
        print(f"Usage: cursor-fx {flag} on|off")
        return 1
    value = "true" if state == "on" else "false"
    pattern = flag_line(flag)
    changed = 0
    for path, lines, at in flag_lines(flag):
        edits = 0
        for i in at:
            m = pattern.match(lines[i])
            if m.group(2) != value:
                lines[i] = m.group(1) + value + m.group(3) + "\n"
                edits += 1
        if edits:
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(lines)
            changed += 1
    if flag == "enter" and state == "on" and drop_enter_pause():
        print("Removed the old `# cursor-fx-enter = off` line from the Ghostty config.")
    print(f"{label}: {state} ({changed} shader{'s' if changed != 1 else ''} changed)")
    if changed and reload_ghostty():
        print("Ghostty reloaded.")
    elif changed:
        print("Press Command+Shift+, in Ghostty to apply it.")
    return 0


# The switches every shader has that follow your Ghostty config (see sync_switches()), and
# what they're called with the reason each is on or off.
SWITCH_LINE = re.compile(r'^(#define\s+(SEE_THROUGH|LIGHT_THEME|PANES)\s+)(true|false)\b(.*)$')
SWITCH_NAMES = {"SEE_THROUGH": ("See-through window support", "Ghostty's background-opacity is below 1", "an opaque window"),
                "LIGHT_THEME": ("Light theme support", "a light background, or a light:/dark: theme pair", "a dark theme"),
                "PANES": ("Pane support", "herdr, or `cursor-fx panes on`", "`cursor-fx panes on` turns it on for tmux panes")}
# Pane support's choice, in the Ghostty config: `cursor-fx panes on|off`, or "on" the first time an
# effect is picked inside herdr (whose sidebar always makes a pane). It never turns itself off.
PANES_CHOICE = re.compile(r'^\s*#\s*cursor-fx-panes\s*=\s*(on|off)\b')


def panes_choice():
    """"on" or "off" from the config's `# cursor-fx-panes = ...` line, else None."""
    try:
        with open(CONFIG, encoding="utf-8") as f:
            return next((m.group(1) for m in (PANES_CHOICE.match(line) for line in f) if m), None)
    except OSError:
        return None


def set_panes_choice(state):
    """Write the config's `# cursor-fx-panes = on|off` line (one, under the effect marker)."""
    with open(CONFIG, encoding="utf-8") as f:
        lines = [line for line in f if not PANES_CHOICE.match(line)]
    line = f"# cursor-fx-panes = {state} (`cursor-fx panes on|off`: Claude Code in herdr or tmux panes)\n"
    at = next((i for i, l in enumerate(lines) if l.startswith(MARKER)), None)
    if at is None:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        lines.append(line)
    else:
        lines.insert(at + 1, line)
    with open(CONFIG, "w", encoding="utf-8") as f:  # in place, so a symlinked config stays a symlink
        f.writelines(lines)


def ghostty_settings():
    """The config Ghostty itself loads, as a dict (`ghostty +show-config`: included files and the
    theme's colors count too). A CURSOR_FX_CONFIG outside Ghostty's folders is a sandbox: that file's
    own lines. One inside them is a local include of the real config: it alone holds no theme or
    opacity, and reading only it would turn the light-theme and see-through code off."""
    if sandboxed() or not GHOSTTY:
        return settings(CONFIG)
    try:
        out = subprocess.run([GHOSTTY, "+show-config"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    found = {}
    for line in out.splitlines():
        m = SETTING.match(line)
        if m:
            found[m.group(1)] = m.group(2).strip('"')
    return found


def wanted_switches():
    """SEE_THROUGH: background-opacity below 1. LIGHT_THEME: a light background (measured as the
    shaders do), or a light:...,dark:... theme pair, which turns light with the system."""
    conf = ghostty_settings()
    try:
        see = float(conf.get("background-opacity", "1")) < 1.0
    except ValueError:
        see = False
    light = "light:" in conf.get("theme", "")
    m = re.match(r"#?([0-9a-fA-F]{6})$", conf.get("background", "").strip())
    if m:
        r, g, b = (int(m.group(1)[i:i + 2], 16) / 255 for i in (0, 2, 4))
        light = light or 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.5
    choice = panes_choice()
    if choice is None and os.environ.get("HERDR_ENV"):
        set_panes_choice("on")
        choice = "on"
    return {"SEE_THROUGH": see, "LIGHT_THEME": light, "PANES": choice == "on"}


def set_panes(state):
    """`cursor-fx panes on|off`: Claude Code in herdr or tmux panes (see PANES in the shaders)."""
    if state is None:
        states = set()
        for path in glob_shaders():
            with open(path, encoding="utf-8") as f:
                for line in f:
                    m = SWITCH_LINE.match(line)
                    if m and m.group(2) == "PANES":
                        states.add(m.group(3))
        print(f"Pane support: {'on' if 'true' in states else 'off'} (cursor-fx panes on|off; for Claude Code in herdr or tmux panes)")
        return 0
    if state not in ("on", "off"):
        print("Usage: cursor-fx panes on|off")
        return 1
    set_panes_choice(state)
    changed = sync_switches()
    if not changed:
        print(f"Pane support: {state} (no shader changed)")
        return 0
    report_switches(changed)
    if reload_ghostty():
        print("Ghostty reloaded.")
    else:
        print("Press Command+Shift+, in Ghostty to apply it.")
    return 0


def glob_shaders():
    return [os.path.join(SHADERS, e) for e in sorted(os.listdir(SHADERS)) if e.endswith(".glsl")] if os.path.isdir(SHADERS) else []


def sync_switches():
    """Set the shaders' SEE_THROUGH and LIGHT_THEME from Ghostty's config. Off, their code costs
    nothing; on, see-through windows and light themes work. Returns {switch: on} for each that changed."""
    want = wanted_switches()
    changed = {}
    if os.path.isdir(SHADERS):
        for entry in sorted(os.listdir(SHADERS)):
            if not entry.endswith(".glsl"):
                continue
            path = os.path.join(SHADERS, entry)
            with open(path, encoding="utf-8") as f:
                lines = f.readlines()
            edits = 0
            for i, line in enumerate(lines):
                m = SWITCH_LINE.match(line)
                value = m and ("true" if want[m.group(2)] else "false")
                if m and m.group(3) != value:
                    lines[i] = m.group(1) + value + m.group(4) + "\n"
                    changed[m.group(2)] = want[m.group(2)]
                    edits += 1
            if edits:
                with open(path, "w", encoding="utf-8") as f:
                    f.writelines(lines)
    return changed


def report_switches(changed):
    for key, on in changed.items():
        label, why_on, why_off = SWITCH_NAMES[key]
        print(f"{label}: {'on' if on else 'off'} ({why_on if on else why_off})")


def switch(name):
    names = [n for n, _ in presets()]
    if name != "off" and name not in names:
        print(f"No cursor effect named '{name}'. Choose one of: {', '.join(names + ['off'])}")
        return 1
    if name != "off":
        report_switches(sync_switches())
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    before = active(lines) or "off"
    if before == name:
        # Still reload, so edits to the effect's shader file take effect.
        reloaded = reload_ghostty()
        print(f"Cursor effect is already: {name}" + (" (reloaded Ghostty)" if reloaded else ""))
        return 0

    # A preset must point at a shader that exists, or Ghostty silently runs without it.
    if name != "off":
        shader = settings(os.path.join(PRESETS, f"{name}.conf")).get("custom-shader")
        if shader and not os.path.isfile(os.path.join(PRESETS, os.path.expanduser(shader))):
            print(f"The '{name}' preset points at a shader that doesn't exist: {shader}")
            return 1

    out = [line for line in lines if not INCLUDE.match(line) and not LAST.match(line)]
    include = f"config-file = cursor-effects/{name}.conf\n"
    at = next((i for i, line in enumerate(out) if line.startswith(MARKER)), None)
    if at is None:
        if out and not out[-1].endswith("\n"):
            out[-1] += "\n"
        out.append(MARKER_LINE)
        at = len(out) - 1
    if name != "off":
        out.insert(at + 1, include)
    elif before != "off":
        out.insert(at + 1, f"# cursor-fx-last = {before} (`cursor-fx toggle` turns it back on)\n")

    sp = savepoint(f"cursor-fx-{name}", before)
    with open(CONFIG, "w", encoding="utf-8") as f:  # in place, so a symlinked config stays a symlink
        f.writelines(out)
    check = subprocess.run([GHOSTTY, "+validate-config", f"--config-file={CONFIG}"],
                           capture_output=True, text=True) if GHOSTTY else None
    if check is None:
        print("Note: `ghostty` wasn't found on PATH, so the config wasn't validated.")
    elif check.returncode != 0:
        shutil.copy2(os.path.join(sp, "ghostty-config"), CONFIG)
        print("Ghostty rejected the new config, so nothing was changed:")
        print(check.stdout + check.stderr)
        return 1

    color = preset_color(name)
    reset_cursor_color()

    print(f"Cursor effect: {name}" + (f" (cursor {color})" if color else ""))
    if color and len(color.lstrip("#")) == 6 and int(color.lstrip("#")[2:], 16) & 0x0101:
        print("Note: this cursor color's green or blue value is odd; the Enter/done effects need both even (e.g. ...fe, not ...ff).")
    if reload_ghostty():
        print("Ghostty reloaded: the effect is live in every window.")
    else:
        print("Press Command+Shift+, in Ghostty to apply it.")
    print(f"Undo: bash {shlex.quote(os.path.join(sp, 'rollback.sh'))}")
    return 0


def toggle():
    """Off when an effect is on; back on to the last one when off (for a hotkey)."""
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    if active(lines):
        return switch("off")
    last = next((m.group(1) for m in (LAST.match(line) for line in lines) if m), None)
    if not last or last not in [n for n, _ in presets()]:
        print("No effect to turn back on yet: pick one with `cursor-fx <name>`.")
        return 1
    return switch(last)


def preset_color(name):
    """The cursor color a preset sets (for "off", the config's or the theme's)."""
    if name == "off":
        theme = settings(CONFIG).get("theme", "")
        return settings(CONFIG).get("cursor-color") or settings(os.path.join(THEMES, theme)).get("cursor-color")
    return settings(os.path.join(PRESETS, f"{name}.conf")).get("cursor-color")


def own_tty():
    """The terminal this command runs in: the first ancestor process that has one."""
    pid = os.getpid()
    while pid > 1:
        out = subprocess.run(["ps", "-o", "ppid=,tty=", "-p", str(pid)],
                             capture_output=True, text=True).stdout.split()
        if len(out) < 2:
            return None
        if out[1] not in ("??", "-"):
            return "/dev/" + out[1]
        pid = int(out[0])
    return None


def signal_enter(argv):
    """Tell the cursor effects that Enter was pressed (a prompt sent, a command run),
    or, with `done`, that the answer arrived (Claude finished, a long command ended).

    Sets the tab's cursor color to the preset's color with the lowest bit of its blue
    value set for Enter, or of its green value for done (invisible to the eye); the
    shaders read those bits, and SIGNAL_TIME later the color is reset. Prints
    nothing: Claude Code adds a UserPromptSubmit hook's output to the prompt.
    """
    tty = argv[argv.index("--tty") + 1] if "--tty" in argv else own_tty()
    kind = "done" if "done" in argv[2:] else "enter"
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    if not enter_enabled(lines):
        return 0
    name = active(lines) or "off"
    color = (preset_color(name) or "").lstrip("#")
    if len(color) != 6:
        return 0
    shader = preset_shader(name)
    if shader and any(s["name"] == ("DONE_EFFECT" if kind == "done" else "ENTER_EFFECT") and s["value"] == "false"
                      for s in shader_settings(shader)):
        return 0  # this effect's Enter (or done) is off: no color change, no timer process
    for target in outer_ttys() or ([tty] if tty else []):
        try:
            send_signal(target, kind, name, color)
        except OSError:
            pass  # a terminal that's gone doesn't stop the others
    return 0


def outer_ttys():
    """The terminals Ghostty itself shows when this runs in a herdr pane: herdr keeps a pane's
    cursor color to itself, so the signal goes past it, to each herdr client's terminal (with
    several, only the focused window plays it). Empty outside herdr."""
    if not os.environ.get("HERDR_ENV"):
        return []
    out = subprocess.run(["ps", "-Ao", "tty=,comm="], capture_output=True, text=True).stdout
    ttys = []
    for line in out.splitlines():
        parts = line.split(None, 1)
        # No terminal: "??" on macOS, "?" on Linux, "-" elsewhere. comm is a full path on macOS.
        if len(parts) == 2 and parts[0] not in ("?", "??", "-") and os.path.basename(parts[1].strip()) == "herdr":
            tty = "/dev/" + parts[0]
            if tty not in ttys:
                ttys.append(tty)
    return ttys


def send_signal(tty, kind, name, color):
    """Set one terminal's cursor color to the signal color, and start the timer that resets it."""
    r, g, b = int(color[:2], 16), int(color[2:4], 16), int(color[4:], 16)
    g, b = (g & ~1, b | 1) if kind == "enter" else (g | 1, b & ~1)
    os.makedirs(CACHE, exist_ok=True)
    marker = os.path.join(CACHE, "signal-" + os.path.basename(tty))
    # Every signal flips the red value's lowest bit (invisible too), so a new one while the
    # last is still on is a change of color the shaders see. Before, they took any cursor
    # jump during a signal for a new one, and a Tab completion replayed the Enter effect.
    try:
        with open(marker, encoding="utf-8") as f:
            parity = 1 - int(f.read().rsplit(":", 1)[1])
    except (OSError, ValueError, IndexError):
        parity = 1 - (r & 1)
    r = (r & ~1) | parity
    signal_color = f"{r:02x}{g:02x}{b:02x}"
    token = f"{time.time():.6f}:{parity}"
    with open(marker, "w", encoding="utf-8") as f:
        f.write(token)
    fd = os.open(tty, os.O_WRONLY | os.O_NONBLOCK)  # never hang on a tab that's gone
    try:
        os.write(fd, f"\033]12;#{signal_color}\007".encode())
    finally:
        os.close(fd)
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "signal-off", tty, marker, token],
                     start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    log = os.path.join(CACHE, "signal.log")
    mode = "w" if os.path.exists(log) and os.path.getsize(log) > 100_000 else "a"
    with open(log, mode, encoding="utf-8") as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {tty} {name} {kind} #{signal_color}\n")
    return 0


def signal_off(tty, marker, token):
    """Reset the cursor color after SIGNAL_TIME, unless a newer signal took over."""
    time.sleep(SIGNAL_TIME)
    try:
        with open(marker, encoding="utf-8") as f:
            if f.read() != token:
                return 0
        with open(tty, "w") as f:
            f.write("\033]112\007")
        os.remove(marker)
    except OSError:
        pass
    return 0


# --- the settings panel (`cursor-fx edit`) -----------------------------------
# Every shader keeps its settings as `const <type> NAME = value;  // what it does`
# lines at the top; the panel reads them, shows a control per line, writes the
# value back into the file and reloads Ghostty. The preview in the page runs the
# very same shader in WebGL.

SETTING_LINE = re.compile(r'^(const\s+(bool|float|int|vec2|vec3)\s+([A-Z][A-Z0-9_]*)\s*=\s*)([^;]+?)(\s*;.*)$')
PRESET_COLOR = re.compile(r'^(\s*cursor-color\s*=\s*)(\S+)(.*)$')
PRESET_BLINK = re.compile(r'^(\s*cursor-style-blink\s*=\s*)(\S+)(.*)$')
PALETTE_LINE = re.compile(r'^\s*palette\s*=\s*(\d+)\s*=\s*(#?[0-9a-fA-F]{6})')


def shader_settings(path):
    """The `const` lines of a shader, in file order: [{name, type, value, comment, section, group}].
    Lines after a `// --- fine-tuning ---` marker are the "fine" section (folded away in the panel);
    a `// -- Name` line starts a group (a heading in the panel) until the next one."""
    out = []
    section, group = "main", None
    with open(path, encoding="utf-8") as f:
        for line in f:
            if re.match(r"^\s*//\s*---\s*fine", line):
                section, group = "fine", None
                continue
            g = re.match(r"^\s*//\s*--\s+(\S.*?)\s*$", line)
            if g:
                group = g.group(1)
                continue
            m = SETTING_LINE.match(line.rstrip("\n"))
            if not m:
                continue
            tail = m.group(5)
            comment = tail.split("//", 1)[1].strip() if "//" in tail else ""
            out.append({"name": m.group(3), "type": m.group(2), "value": m.group(4).strip(),
                        "comment": comment, "section": section, "group": group})
    return out


def glsl_value(kind, value):
    """`value` from the page (bool, number or list) as GLSL source for a `const` of
    this type, or None if it doesn't fit."""
    def num(v):
        v = float(v)
        if v != v or v in (float("inf"), float("-inf")):
            raise ValueError(v)
        s = f"{v:.4f}".rstrip("0")
        return s + "0" if s.endswith(".") else s
    try:
        if kind == "bool":
            return "true" if value else "false"
        if kind == "float":
            return num(value)
        if kind == "int":
            return str(int(value))
        n = {"vec2": 2, "vec3": 3}[kind]
        parts = [num(v) for v in value]
        if len(parts) != n:
            return None
        return f"{kind}({', '.join(parts)})"
    except (TypeError, ValueError, KeyError):
        return None


def set_shader_value(path, name, source):
    """Rewrite one `const` line's value (as GLSL source text). False if there is no such line."""
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
    for i, line in enumerate(lines):
        m = SETTING_LINE.match(line.rstrip("\n"))
        if m and m.group(3) == name:
            lines[i] = m.group(1) + source + m.group(5) + "\n"
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(lines)
            return True
    return False


def set_preset_color(name, color):
    """Write a preset's `cursor-color` (color as rrggbb). False if the preset has none."""
    path = os.path.join(PRESETS, f"{name}.conf")
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
    for i, line in enumerate(lines):
        m = PRESET_COLOR.match(line.rstrip("\n"))
        if m:
            lines[i] = m.group(1) + "#" + color + m.group(3) + "\n"
            with open(path, "w", encoding="utf-8") as f:
                f.writelines(lines)
            return True
    return False


def preset_blink(name):
    """Whether the cursor blinks with a preset: its own `cursor-style-blink`, else the main config's (Ghostty's default: on)."""
    own = settings(os.path.join(PRESETS, f"{name}.conf")).get("cursor-style-blink")
    if own is None:
        own = settings(CONFIG).get("cursor-style-blink", "true")
    return own.strip().lower() != "false"


def set_preset_blink(name, on):
    """Write a preset's `cursor-style-blink` (a preset's settings override the main config's), after its cursor-color line if it has none yet.
    None removes the line, so the preset follows the main config again."""
    path = os.path.join(PRESETS, f"{name}.conf")
    with open(path, encoding="utf-8") as f:
        lines = f.readlines()
    if on is None:
        lines = [line for line in lines if not PRESET_BLINK.match(line.rstrip("\n"))]
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(lines)
        return
    value = "true" if on else "false"
    for i, line in enumerate(lines):
        m = PRESET_BLINK.match(line.rstrip("\n"))
        if m:
            lines[i] = m.group(1) + value + m.group(3) + "\n"
            break
    else:
        at = next((i + 1 for i, line in enumerate(lines) if PRESET_COLOR.match(line.rstrip("\n"))), len(lines))
        lines.insert(at, f"cursor-style-blink = {value}\n")
    with open(path, "w", encoding="utf-8") as f:
        f.writelines(lines)


# --- Keeping your settings across upgrades ---
# install.sh records the defaults it installed (DEFAULTS_FILE). On the next install, whatever
# differs between your installed files and those defaults is yours (the panel, `cursor-fx
# jumps|idle|subtle`, a hand edit) and goes back into the new version; everything you never
# touched takes the new version's default. Without that file (an install of v1.0.0), the
# defaults of v1.0.0 (upgrade/v1.0.0-defaults.json) stand in for it.
DEFAULTS_FILE = os.path.join(PRESETS, ".installed-defaults.json")


def setting_key(kind, value):
    """A setting's value in a form that compares equal however it is written (0.3 == 0.30)."""
    if kind == "bool":
        return value.strip()
    nums = re.findall(r'[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?', value)
    return [round(float(n), 6) for n in nums] if nums else value.strip()


def settings_snapshot(shader_dir, preset_dir):
    """Every shader's settings and every preset's cursor color and blinking, as files hold them."""
    snap = {"shaders": {}, "presets": {}}
    if os.path.isdir(shader_dir):
        for entry in sorted(os.listdir(shader_dir)):
            if entry.endswith("-cursor.glsl"):
                found = shader_settings(os.path.join(shader_dir, entry))
                snap["shaders"][entry] = {s["name"]: [s["type"], s["value"]] for s in found}
    if os.path.isdir(preset_dir):
        for entry in sorted(os.listdir(preset_dir)):
            if entry.endswith(".conf"):
                own = settings(os.path.join(preset_dir, entry))
                snap["presets"][entry] = {k: own.get(k) for k in ("cursor-color", "cursor-style-blink")}
    return snap


def keep_save(repo, out):
    """Before an install: what you changed from the defaults you installed, written to `out`."""
    base_path = DEFAULTS_FILE if os.path.isfile(DEFAULTS_FILE) else os.path.join(repo, "upgrade", "v1.0.0-defaults.json")
    changes = {"shaders": {}, "presets": {}}
    if not os.path.isfile(base_path) and os.path.isdir(SHADERS) and any(e.endswith("-cursor.glsl") for e in os.listdir(SHADERS)):
        print("Note: there is no record of the defaults you installed, so settings you changed can't be told\n"
              "apart and the new version's defaults are used. Your old files are in ~/ghostty-savepoints.")
    if os.path.isfile(base_path):
        with open(base_path, encoding="utf-8") as f:
            base = json.load(f)
        mine = settings_snapshot(SHADERS, PRESETS)
        for entry, values in mine["shaders"].items():
            was = base.get("shaders", {}).get(entry, {})
            for name, (kind, value) in values.items():
                if name in was and was[name][0] == kind and setting_key(kind, value) != setting_key(kind, was[name][1]):
                    changes["shaders"].setdefault(entry, {})[name] = [kind, value]
        for entry, values in mine["presets"].items():
            was = base.get("presets", {}).get(entry)
            if was is None:
                continue
            for key, value in values.items():
                if (value or "").strip().lower() != (was.get(key) or "").strip().lower():
                    changes["presets"].setdefault(entry, {})[key] = value
    with open(out, "w", encoding="utf-8") as f:
        json.dump(changes, f, indent=1)
    return 0


def keep_apply(changes_path, repo):
    """After an install: put your changes back into the new files and record the new defaults."""
    with open(changes_path, encoding="utf-8") as f:
        changes = json.load(f)
    kept, dropped = [], []
    for entry, values in changes.get("shaders", {}).items():
        path = os.path.join(SHADERS, entry)
        now = {s["name"]: s["type"] for s in shader_settings(path)} if os.path.isfile(path) else {}
        for name, (kind, value) in values.items():
            if now.get(name) == kind and set_shader_value(path, name, value):
                kept.append((entry[:-12], f"{name} = {value}"))
            else:
                dropped.append(f"{entry[:-12]}: {name}")
    for entry, values in changes.get("presets", {}).items():
        name = entry[:-5]
        if not os.path.isfile(os.path.join(PRESETS, entry)):
            dropped.append(f"{name}: preset")
            continue
        for key, value in values.items():
            if key == "cursor-color" and value and set_preset_color(name, value.strip().lstrip("#")):
                kept.append((name, f"cursor-color = {value}"))
            elif key == "cursor-style-blink":
                set_preset_blink(name, None if value is None else value.strip().lower() != "false")
                kept.append((name, f"cursor-style-blink = {value if value is not None else '(from your Ghostty config)'}"))
    # Before 1.1, `cursor-fx enter off` left a comment in the Ghostty config; now the shaders hold it.
    if enter_paused():
        quietly(set_flag, "enter", "off")
        drop_enter_pause()
        kept.append(("Enter & done", "off (was a comment in your Ghostty config, now the effects' own switches)"))
    with open(DEFAULTS_FILE, "w", encoding="utf-8") as f:
        json.dump(settings_snapshot(os.path.join(repo, "shaders"), os.path.join(repo, "cursor-effects")), f, indent=1)
    if kept:
        print("Kept your settings:")
        whose = {}
        for who, what in kept:
            whose.setdefault(what, []).append(who)
        for what, who in whose.items():  # the same change in several effects (a shared switch): one line
            print(f"  {what} ({len(who)} effects)" if len(who) > 1 else f"  {who[0]}: {what}")
    if dropped:
        print("Not carried over (gone from this version): " + ", ".join(dropped))
    return 0


def preset_shader(name):
    """Path of the shader file a preset points at, or None."""
    shader = settings(os.path.join(PRESETS, f"{name}.conf")).get("custom-shader")
    if not shader:
        return None
    path = os.path.join(PRESETS, os.path.expanduser(shader))
    return path if os.path.isfile(path) else None


def installed_defaults():
    """What install.sh recorded as the defaults it installed ({} without that file)."""
    try:
        with open(DEFAULTS_FILE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


# Number settings that count things (whole steps), and shares of something (at most 1).
COUNT_SETTINGS = {"SPARKS", "TYPE_EMBERS", "ENTER_EMBERS", "JUMP_EMBERS", "ENTER_PIXELS", "BRANCHES",
                  "SLICES", "NOISE_BLOCKS", "TRAIL"}
SHARE_SETTINGS = {"DENSITY", "GLOW_CORE", "LINE_COLOR", "TEXT_TINT", "CURSOR_SHADE", "BREATH_DEPTH", "SCANLINE_DEPTH"}
ENTER_LONGEST = 1.8  # an Enter or done moment must be over before the signal ends (SIGNAL_TIME)


def setting_limits(setting, default=None):
    """The range a number setting may take, {min, max, step, int}, or None for other kinds.
    The note decides what it can: "(0 to 1)", "at most N", "(0 = none)" (zero allowed; otherwise
    a value that starts above zero stays above it: it divides something). The rest comes from
    the shipped default, so the range is the same every time the panel opens."""
    if setting["type"] not in ("float", "int"):
        return None
    try:
        base = float(default)
    except (TypeError, ValueError):
        try:
            base = float(setting["value"])
        except ValueError:
            base = 0.0
    note, name = setting.get("comment", ""), setting["name"]
    whole = setting["type"] == "int" or name in COUNT_SETTINGS
    big = abs(base)
    if whole:
        step, high = 1, max(4, math.ceil(big * 3))
    else:
        step = 0.01 if big <= 1 else 0.05 if big <= 10 else 0.5
        high = 1 if big <= 0.2 else 2 if big <= 1 else math.ceil(big * 3)
    zero = bool(re.search(r"\b0 = |\b0 to 1\b", note))
    low = 0 if (zero or base <= 0) else (1 if whole else step)
    low = min(low, base)
    most = re.search(r"\bat most (\d+(?:\.\d+)?)", note)
    if most:
        high = float(most.group(1))
    if re.search(r"\b0 to 1\b|\(1 = ", note) or name in SHARE_SETTINGS or name.endswith("_ALPHA"):
        high = 1
    if setting.get("group") == "Enter & done" and note.startswith("seconds"):
        high = min(high, ENTER_LONGEST)
    choices = re.findall(r"(?:^|[:,]\s*)(\d+)\s+[^\d,\s]", note) if setting["type"] == "int" else []
    if len(choices) > 1:  # "...: 0 one, 1 two, 2 three" (named buttons in the panel)
        low, high = 0, max(int(c) for c in choices)
    high = max(high, low + step)
    return {"min": low, "max": high, "step": step, "int": whole}


def terminal_colors():
    """Background, text, cursor-text and palette the preview draws with: the config's
    own values, else the theme file's, else Ghostty-like defaults."""
    conf = settings(CONFIG)
    theme = conf.get("theme", "")
    colors = {"background": "#1e1e2e", "foreground": "#cdd6f4", "cursorText": "", "palette": [""] * 16}
    for path in (os.path.join(THEMES, theme), CONFIG):
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    m = PALETTE_LINE.match(line)
                    if m and int(m.group(1)) < 16:
                        colors["palette"][int(m.group(1))] = "#" + m.group(2).lstrip("#")
        except OSError:
            pass
        values = settings(path)
        for key, mine in (("background", "background"), ("foreground", "foreground"), ("cursor-text", "cursorText")):
            if values.get(key, "").startswith("#"):
                colors[mine] = values[key]
    return colors


def savepoint_effects(label):
    """Copy every shader and preset, and the Ghostty config, into a savepoint with a rollback script."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    sp = os.path.join(SAVEPOINTS, f"{stamp}-before-{label}")
    n = 2
    while os.path.exists(sp):
        sp = os.path.join(SAVEPOINTS, f"{stamp}-{n}-before-{label}")
        n += 1
    os.makedirs(os.path.join(sp, "shaders"))
    os.makedirs(os.path.join(sp, "cursor-effects"))
    sums = []
    for src, sub, ext in ((SHADERS, "shaders", ".glsl"), (PRESETS, "cursor-effects", ".conf")):
        for entry in sorted(os.listdir(src)):
            if entry.endswith(ext):
                shutil.copy2(os.path.join(src, entry), os.path.join(sp, sub, entry))
                with open(os.path.join(src, entry), "rb") as f:
                    sums.append(f"{hashlib.sha256(f.read()).hexdigest()}  {sub}/{entry}\n")
    shutil.copy2(CONFIG, os.path.join(sp, "ghostty-config"))
    with open(CONFIG, "rb") as f:
        sums.append(f"{hashlib.sha256(f.read()).hexdigest()}  ghostty-config\n")
    with open(os.path.join(sp, "SHA256SUMS"), "w", encoding="utf-8") as f:
        f.writelines(sums)
    script = f"""#!/bin/bash
set -euo pipefail
savepoint_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
( cd "$savepoint_dir" && shasum -a 256 -c SHA256SUMS >/dev/null )
rescue_dir="$(mktemp -d "$savepoint_dir/pre-rollback.XXXXXX")"
mkdir -p "$rescue_dir/shaders" "$rescue_dir/cursor-effects"
cp -p {shlex.quote(CONFIG)} "$rescue_dir/ghostty-config"
cp -p "$savepoint_dir/ghostty-config" {shlex.quote(CONFIG)}
for f in "$savepoint_dir"/shaders/*.glsl; do
  name="$(basename "$f")"
  [ -f {shlex.quote(SHADERS)}/"$name" ] && cp -p {shlex.quote(SHADERS)}/"$name" "$rescue_dir/shaders/"
  cp -p "$f" {shlex.quote(SHADERS)}/"$name"
done
for f in "$savepoint_dir"/cursor-effects/*.conf; do
  name="$(basename "$f")"
  [ -f {shlex.quote(PRESETS)}/"$name" ] && cp -p {shlex.quote(PRESETS)}/"$name" "$rescue_dir/cursor-effects/"
  cp -p "$f" {shlex.quote(PRESETS)}/"$name"
done
echo "Restored every cursor effect shader and preset, and the Ghostty config, from before {label}. The files from before this rollback are in: $rescue_dir"
echo "Run cursor-fx <name of the active effect> to reload Ghostty."
"""
    with open(os.path.join(sp, "rollback.sh"), "w", encoding="utf-8") as f:
        f.write(script)
    os.chmod(os.path.join(sp, "rollback.sh"), 0o755)
    return sp


def system_language():
    """'zh' when the system's first preferred language is Chinese, else 'en'
    (macOS: AppleLanguages; elsewhere LC_ALL / LC_MESSAGES / LANG)."""
    langs = []
    if sys.platform == "darwin":
        try:
            out = subprocess.run(["defaults", "read", "-g", "AppleLanguages"], capture_output=True, text=True, timeout=3).stdout
            langs = re.findall(r'"?([A-Za-z]{2,3}(?:[-_][A-Za-z0-9]+)*)"?\s*[,)]', out)
        except (OSError, subprocess.SubprocessError):
            pass
    langs += [os.environ.get(k, "") for k in ("LC_ALL", "LC_MESSAGES", "LANG")]
    first = next((l for l in langs if l and l not in ("C", "POSIX")), "en")
    return "zh" if first.lower().startswith("zh") else "en"


def panel_state(session):
    with open(CONFIG, encoding="utf-8") as f:
        lines = f.readlines()
    effects = []
    shipped = installed_defaults().get("shaders", {})
    for name, desc in presets():
        path = preset_shader(name)
        if not path:
            continue
        with open(path, encoding="utf-8") as f:
            source = f.read()
        found = shader_settings(path)
        defaults = shipped.get(os.path.basename(path), {})
        for s in found:
            default = defaults.get(s["name"])
            opened = session.get("original", {}).get(name, {}).get("settings", {}).get(s["name"])
            s["limits"] = setting_limits(s, default[1] if default and default[0] == s["type"] else opened)
        effects.append({"name": name, "description": desc, "color": preset_color(name) or "", "blink": preset_blink(name),
                        "shader": os.path.basename(path), "settings": found, "source": source})
    return {"effects": effects, "active": active(lines) or "off", "enterPaused": not enter_enabled(lines),
            "hasDefaults": bool(shipped),
            "colors": terminal_colors(),
            "yDown": sys.platform == "darwin", "sysLang": system_language(),
            "sharedFlags": [n for names, _ in FLAGS.values() for n in names],
            "savepoint": session.get("savepoint"), "original": session["original"]}


def quietly(func, *args):
    """Run a command function and return (its return code, what it printed)."""
    out = io.StringIO()
    with contextlib.redirect_stdout(out):
        code = func(*args)
    return code, out.getvalue().strip()


def make_panel_handler(session):
    def ensure_savepoint():
        if not session.get("savepoint"):
            session["savepoint"] = savepoint_effects("cursor-fx-edit")

    def schedule_reload():
        if session.get("timer"):
            session["timer"].cancel()
        session["timer"] = threading.Timer(0.3, reload_ghostty)
        session["timer"].daemon = True
        session["timer"].start()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def reply(self, code, body, ctype="application/json; charset=utf-8"):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            url = urlparse(self.path)
            if url.path == "/" and parse_qs(url.query).get("t", [""])[0] == session["token"]:
                session["last"] = time.time()
                state = json.dumps(panel_state(session)).replace("</", "<\\/")
                page = (PANEL_HTML.replace("__TOKEN__", session["token"]).replace("__STATE__", state)
                        .replace("__ZH__", json.dumps(PANEL_ZH, ensure_ascii=False).replace("</", "<\\/")))
                return self.reply(200, page, "text/html; charset=utf-8")
            if url.path == "/favicon.ico":
                return self.reply(204, "")
            self.reply(403, '{"error": "forbidden"}')

        def do_POST(self):
            if self.headers.get("X-Token") != session["token"]:
                return self.reply(403, '{"error": "forbidden"}')
            session["last"] = time.time()
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            except ValueError:
                return self.reply(400, '{"error": "bad request"}')
            path = urlparse(self.path).path
            effect = str(body.get("effect", ""))
            names = [n for n, _ in presets()]
            if path == "/quit":
                self.reply(200, '{"ok": true}')
                threading.Thread(target=session["server"].shutdown, daemon=True).start()
                return
            if path == "/state":
                return self.reply(200, json.dumps(panel_state(session)))
            if path == "/toggle":
                what, state = body.get("what"), "on" if body.get("on") else "off"
                if what not in FLAGS:
                    return self.reply(400, '{"error": "unknown switch"}')
                ensure_savepoint()
                _, message = quietly(set_flag, what, state)
                return self.reply(200, json.dumps({"ok": True, "message": message, "savepoint": session["savepoint"]}))
            if path == "/undo":
                # Everything back to how it was before this session's first change (the
                # savepoint's own rollback script), then Ghostty reloads.
                sp = session.get("savepoint")
                if not sp:
                    return self.reply(400, '{"error": "nothing to undo"}')
                try:
                    done = subprocess.run(["bash", os.path.join(sp, "rollback.sh")], capture_output=True, text=True, timeout=30)
                except (OSError, subprocess.SubprocessError) as err:
                    return self.reply(500, json.dumps({"error": str(err)}))
                if done.returncode != 0:
                    return self.reply(500, json.dumps({"error": (done.stderr or done.stdout).strip()[-300:] or "rollback failed"}))
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True}))
            if effect not in names:
                return self.reply(400, '{"error": "unknown effect"}')
            if path == "/activate":
                ensure_savepoint()  # so "Undo this session" brings the effect you had back too
                code, message = quietly(switch, effect)
                return self.reply(200, json.dumps({"ok": code == 0, "message": message, "savepoint": session["savepoint"]}))
            shader = preset_shader(effect)
            if path == "/set":
                name = str(body.get("name"))
                setting = next((s for s in shader_settings(shader) if s["name"] == name), None) if shader else None
                if not setting or setting["type"] != body.get("type"):
                    return self.reply(400, '{"error": "unknown setting"}')
                value = body.get("value")
                default = installed_defaults().get("shaders", {}).get(os.path.basename(shader), {}).get(name)
                opened = session["original"].get(effect, {}).get("settings", {}).get(name)
                limits = setting_limits(setting, default[1] if default and default[0] == setting["type"] else opened)
                if limits:  # the same range the page shows
                    try:
                        value = min(max(float(value), limits["min"]), limits["max"])
                    except (TypeError, ValueError):
                        return self.reply(400, '{"error": "bad value"}')
                    if limits["int"]:
                        value = round(value)
                source = glsl_value(setting["type"], value)
                if source is None:
                    return self.reply(400, '{"error": "bad value"}')
                ensure_savepoint()
                set_shader_value(shader, name, source)
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True, "source": source, "savepoint": session["savepoint"]}))
            if path == "/color":
                color = str(body.get("color", "")).lstrip("#").lower()
                if not re.fullmatch(r"[0-9a-f]{6}", color):
                    return self.reply(400, '{"error": "bad color"}')
                color = f"{color[:2]}{int(color[2:4], 16) & ~1:02x}{int(color[4:], 16) & ~1:02x}"  # the signals need even green and blue
                ensure_savepoint()
                if not set_preset_color(effect, color):
                    return self.reply(400, '{"error": "preset has no cursor-color"}')
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True, "color": "#" + color, "savepoint": session["savepoint"]}))
            if path == "/blink":
                ensure_savepoint()
                set_preset_blink(effect, bool(body.get("on")))
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True, "blink": preset_blink(effect), "savepoint": session["savepoint"]}))
            if path == "/reset":
                # The defaults install.sh recorded; without them, the values from when the panel opened.
                shipped = installed_defaults()
                values = shipped.get("shaders", {}).get(os.path.basename(shader or ""))
                own = shipped.get("presets", {}).get(f"{effect}.conf")
                original = session["original"].get(effect)
                if not shader or (values is None and not original):
                    return self.reply(400, '{"error": "nothing to reset"}')
                ensure_savepoint()
                if values is not None:
                    for s in shader_settings(shader):
                        if s["name"] in ("IDLE_EFFECTS", "SUBTLE"):  # shared choices (header switches): kept
                            continue
                        default = values.get(s["name"])
                        if default and default[0] == s["type"]:
                            set_shader_value(shader, s["name"], default[1])
                    color, blink = (own or {}).get("cursor-color"), (own or {}).get("cursor-style-blink")
                    if own is None:
                        color, blink = original["color"] if original else None, original["ownBlink"] if original else None
                else:
                    for name, value in original["settings"].items():
                        if name not in ("IDLE_EFFECTS", "SUBTLE"):
                            set_shader_value(shader, name, value)
                    color, blink = original["color"], original["ownBlink"]
                if color:
                    set_preset_color(effect, color.strip().lstrip("#"))
                set_preset_blink(effect, None if blink is None else blink.strip().lower() != "false")
                schedule_reload()
                return self.reply(200, json.dumps({"ok": True, "savepoint": session["savepoint"], "shipped": values is not None}))
            self.reply(404, '{"error": "not found"}')

    return Handler


def edit_panel(open_browser=True):
    if not os.path.isdir(PRESETS):
        print(f"No cursor effects found in {PRESETS}")
        return 1
    original = {}
    for name, _ in presets():
        path = preset_shader(name)
        if path:
            original[name] = {"color": preset_color(name) or "",
                              "ownBlink": settings(os.path.join(PRESETS, f"{name}.conf")).get("cursor-style-blink"),
                              "settings": {s["name"]: s["value"] for s in shader_settings(path)}}
    session = {"token": secrets.token_urlsafe(16), "last": time.time(), "original": original}
    server = ThreadingHTTPServer(("127.0.0.1", 0), make_panel_handler(session))
    session["server"] = server

    def close_when_idle():  # a forgotten panel shuts itself down after an hour without use
        while time.time() - session["last"] < 3600:
            time.sleep(60)
        server.shutdown()

    threading.Thread(target=close_when_idle, daemon=True).start()
    url = f"http://127.0.0.1:{server.server_port}/?t={session['token']}"
    print(f"Cursor effects panel: {url}")
    print("Changes apply to Ghostty as you make them. Close the panel (or press Ctrl-C here) when done.", flush=True)
    if open_browser:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    if session.get("savepoint"):
        print(f"\nDone. Undo everything from this session: bash {shlex.quote(os.path.join(session['savepoint'], 'rollback.sh'))}")
    else:
        print("\nNo changes.")
    return 0


