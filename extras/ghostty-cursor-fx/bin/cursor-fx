// An int whose note ends in "...: 0 one, 1 two, 2 three" is a choice: {help, items: [[0, "One"], ...]}.
function choicesOf(s) {
  const m = helpOf(s).match(/^(.*?)[:：]\s*((?:\d+\s*[^,，]+[,，]\s*)+\d+\s*[^,，]+)$/);
  if (!m) return null;
  const items = m[2].split(/[,，]\s*/).map(x => { const k = x.match(/^(\d+)\s*(.+)$/); return k ? [Number(k[1]), k[2].trim().replace(/^./, c => c.toUpperCase())] : null; });
  return items.every(Boolean) ? { help: m[1], items } : null;
}
// "typing: how each letter decrypts" under the Typing heading reads "how each letter decrypts".
function noteFor(text, group) {
  if (!text || !group) return text;
  for (const g of [group, groupOf(group)]) {
    const low = text.toLowerCase(), pre = g.toLowerCase();
    for (const sep of [": ", "："]) if (low.startsWith(pre + sep)) return text.slice(pre.length + sep.length);
  }
  return text;
}
const helpOf = s => LANG === "zh" && ZH.comments[s.comment] ? ZH.comments[s.comment] : s.comment;
function applyLang() {
  document.documentElement.lang = LANG === "zh" ? "zh-CN" : "en"; document.title = t("title");
  $("#hTitle").textContent = t("title"); $("#lAll").textContent = t("allEffects"); $("#lEnter").textContent = t("enterSw"); $("#enterLabel").title = t("enterTip"); $("#lJumps").textContent = t("jumpsSw"); $("#jumpsLabel").title = t("jumpsTip");
  $("#lIdle").textContent = t("idleSw"); $("#idleLabel").title = t("idleTip");
  $("#lSubtle").textContent = t("subtleSw"); $("#subtleLabel").title = t("subtleTip");
  $("#doneBtn").textContent = t("done"); $("#doneBtn").title = t("doneTip");
  $("#langBtn").textContent = LANG === "zh" ? "English" : "中文"; $("#langBtn").title = t("langTip");
  // The undo button keeps one width for both of its labels, so nothing in the header moves.
  const b = $("#undoBtn"); b.style.minWidth = "";
  const widths = ["undoAgain", "undo"].map(k => { b.textContent = t(k); return b.offsetWidth; });
  b.style.minWidth = Math.max(...widths) + "px";
  undoArmed = false; showUndo();
}
// "Undo this session": usable once something changed; the first click arms it (the status says
// what it will do), a second click within 6 s runs it.
let undoArmed = false, undoTimer;
function showUndo() {
  const b = $("#undoBtn"); b.disabled = !STATE.savepoint; b.title = t("undoTip");
  b.textContent = t(undoArmed ? "undoAgain" : "undo"); b.classList.toggle("danger", undoArmed);
}

// --- preview: the shader itself, run in WebGL over a drawn terminal --------
const W = 1200, H = 420, CH = 44, PADX = 16, PADY = 12, ROW = 6;
const term = document.createElement("canvas"); term.width = W; term.height = H;
const tc = term.getContext("2d"); tc.font = "30px Menlo, Consolas, monospace"; const CW = tc.measureText("M").width;
const cv = document.createElement("canvas"); cv.width = W; cv.height = H;
const gl = cv.getContext("webgl2", { preserveDrawingBuffer: true });
const PRELUDE = `#version 300 es
precision highp float; precision highp int;
uniform vec3 iResolution; uniform float iTime;
uniform vec4 iCurrentCursor; uniform vec4 iPreviousCursor;
uniform vec4 iCurrentCursorColor; uniform vec4 iPreviousCursorColor;
uniform int iCurrentCursorStyle; uniform int iCursorVisible;
uniform float iTimeCursorChange; uniform int iFocus;
uniform vec3 iPalette[16];
uniform vec3 iBackgroundColor; uniform vec3 iForegroundColor; uniform vec3 iCursorText;
#define CURSORSTYLE_BLOCK 0
uniform sampler2D iChannel0;
out vec4 _fragColor;
vec4 texLin(sampler2D s, vec2 uv) { vec4 c = texture(s, uv); return vec4(pow(c.rgb, vec3(2.2)), c.a); }
#define texture texLin
`;
const POST = `
void main() { vec4 c; mainImage(c, ${STATE.yDown ? "vec2(gl_FragCoord.x, iResolution.y - gl_FragCoord.y)" : "gl_FragCoord.xy"}); _fragColor = vec4(pow(c.rgb, vec3(1.0 / 2.2)), 1.0); }
`;
let prog = null, uni = {}, previewError = null;
function compileShader(type, src) { const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; }
function buildProgram(source) {
  const p = gl.createProgram();
  gl.attachShader(p, compileShader(gl.VERTEX_SHADER, "#version 300 es\nin vec2 pos; void main() { gl_Position = vec4(pos, 0.0, 1.0); }"));
  gl.attachShader(p, compileShader(gl.FRAGMENT_SHADER, PRELUDE + source + POST));
  gl.linkProgram(p);
  if (!gl.getProgramParameter(p, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(p));
  return p;
}
const buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf); gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
const tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, tex); gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, !STATE.yDown);
for (const [k, v] of [[gl.TEXTURE_MIN_FILTER, gl.NEAREST], [gl.TEXTURE_MAG_FILTER, gl.NEAREST], [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE], [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE]]) gl.texParameteri(gl.TEXTURE_2D, k, v);
gl.viewport(0, 0, W, H);
// The source the preview last compiled (previewError belongs to it).
let previewSource = null;
// Whether a shader source compiles (the preview's when it's that source, else a throwaway build).
function compiles(source) {
  if (source === previewSource) return !previewError;
  try { gl.deleteProgram(buildProgram(source)); return true; } catch (e) { return false; }
}
function usePreview(source) {
  previewSource = source;
  try { const p = buildProgram(source); if (prog) gl.deleteProgram(prog); prog = p; previewError = null; }
  catch (e) { previewError = String(e.message || e); return; }
  gl.useProgram(prog);
  const loc = gl.getAttribLocation(prog, "pos"); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
  uni = {}; for (const n of ["iResolution", "iTime", "iCurrentCursor", "iPreviousCursor", "iCurrentCursorColor", "iPreviousCursorColor", "iCurrentCursorStyle", "iCursorVisible", "iTimeCursorChange", "iFocus", "iPalette", "iBackgroundColor", "iForegroundColor", "iCursorText", "iChannel0"]) uni[n] = gl.getUniformLocation(prog, n);
  const c = STATE.colors;
  gl.uniform3f(uni.iResolution, W, H, 1);
  gl.uniform3f(uni.iBackgroundColor, ...hexToRgb(c.background));
  gl.uniform3f(uni.iForegroundColor, ...hexToRgb(c.foreground));
  gl.uniform3f(uni.iCursorText, ...hexToRgb(c.cursorText || c.background));
  gl.uniform1i(uni.iCurrentCursorStyle, 0); gl.uniform1i(uni.iCursorVisible, 1); gl.uniform1i(uni.iFocus, 1); gl.uniform1i(uni.iChannel0, 0);
  const pal = new Float32Array(48);
  const fallback = ["#000000", "#cc0000", "#4e9a06", "#c4a000", "#3465a4", "#75507b", "#06989a", "#d3d7cf", "#555753", "#ef2929", "#8ae234", "#fce94f", "#729fcf", "#ad7fa8", "#34e2e2", "#eeeeec"];
  for (let i = 0; i < 16; i++) pal.set(hexToRgb(c.palette[i] || fallback[i]), i * 3);
  gl.uniform3fv(uni.iPalette, pal);
  drawTerm();
}
// The drawn terminal: a Claude Code-like screen with a sent prompt on a bar, the
// input box between two lines, and a status line.
const sim = { preedit: "", input: "", sent: "make the cursor effects awesome", cur: 2, prev: 2, prevRow: 0, change: 0, signalUntil: 0, signalPrev: false, kind: "enter", color: "#f85552" };
function lighten(hex, k) { return rgbToHex(hexToRgb(hex).map(v => v + (1 - v) * k)); }
// Chinese, Japanese and Korean characters take two cells, as in the terminal.
const WIDE = /[\u1100-\u115F\u2E80-\u303E\u3041-\u33FF\u3400-\u4DBF\u4E00-\u9FFF\uA000-\uA4CF\uAC00-\uD7A3\uF900-\uFAFF\uFE30-\uFE4F\uFF00-\uFF60\uFFE0-\uFFE6]|[\u{20000}-\u{3FFFD}]/u;
const cellsOf = text => Array.from(text).reduce((n, ch) => n + (WIDE.test(ch) ? 2 : 1), 0);
// Text drawn cell by cell from a column; returns the column after it.
function drawCells(text, col, row, color) {
  tc.fillStyle = color;
  for (const ch of Array.from(text)) {
    const x = PADX + col * CW, y = PADY + row * CH + 6;
    if (WIDE.test(ch)) {
      tc.save(); tc.font = `${Math.round(CH * 0.66)}px "PingFang SC", "Hiragino Sans GB", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif`;
      tc.fillText(ch, x + (2 * CW - tc.measureText(ch).width) / 2, y + 1); tc.restore(); col += 2;
    } else { tc.fillText(ch, x, y); col += 1; }
  }
  return col;
}
function drawTerm() {
  const c = STATE.colors, bg = c.background, fg = c.foreground;
  tc.fillStyle = bg; tc.fillRect(0, 0, W, H); tc.textBaseline = "top";
  tc.fillStyle = lighten(bg, 0.06); tc.fillRect(0, PADY + 2 * CH, W, CH);
  tc.fillStyle = lighten(bg, 0.3); for (const r of [5, 7]) tc.fillRect(PADX, PADY + r * CH + CH / 2 - 1, W - 2 * PADX, 2);
  const lines = ["● Done: the effects are installed.", "", "❯ " + sim.sent, "", "✻ Thinking…", "", "", "", "  Opus 5.5 ¦ Ghostty ¦ ctx 32%"];
  lines.forEach((l, r) => { if (r === 2 || r === ROW) return; tc.fillStyle = r === 8 ? lighten(bg, 0.35) : fg; tc.fillText(l, PADX, PADY + r * CH + 6); });
  drawCells("❯ " + sim.sent, 0, 2, fg);
  drawCells("❯ " + sim.input, 0, ROW, fg);
  if (sim.preedit) {
    // Text the input method is still composing: underlined at the cursor, the cursor hidden.
    const end = drawCells(sim.preedit, sim.cur, ROW, fg);
    tc.fillStyle = fg; tc.fillRect(Math.round(PADX + sim.cur * CW), PADY + ROW * CH + CH - 5, Math.round((end - sim.cur) * CW), 2);
  } else {
    tc.fillStyle = sim.color; tc.fillRect(Math.round(PADX + sim.cur * CW), PADY + ROW * CH, Math.round(CW), CH);
  }
  gl.bindTexture(gl.TEXTURE_2D, tex); gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, term);
}
// Ghostty on macOS (Metal) hands shaders y-down pixels, the cursor's .y being
// its bottom edge; on Linux (OpenGL) y-up, .y the top edge. The preview does the
// same as the Ghostty on this machine (see POST and the texture's FLIP_Y).
const rect = (row, col) => [Math.round(PADX + col * CW), STATE.yDown ? PADY + (row + 1) * CH : H - (PADY + row * CH), Math.round(CW), CH];
// The preview's clock: seconds, running at SPEED (slow motion below 1); its timers follow it.
let SPEED = 1, ZOOM = 1, clockBase = 0, clockReal = performance.now();
const now = () => clockBase + (performance.now() - clockReal) / 1000 * SPEED;
function setSpeed(v) { clockBase = now(); clockReal = performance.now(); SPEED = v; lastAction = now(); }
const later = (fn, ms) => setTimeout(fn, ms / SPEED);
// The preview runs at full rate for a few seconds after anything happens, then
// ticks slowly (idle animations still move) so a panel left open costs little.
let lastAction = 0, frameNo = 0;
function oddBlue(hex) { const c = hexToRgb(hex); return [c[0], c[1], (Math.round(c[2] * 255) | 1) / 255]; }
function oddGreen(hex) { const c = hexToRgb(hex); return [c[0], (Math.round(c[1] * 255) | 1) / 255, c[2]]; }
function frame() {
  requestAnimationFrame(frame);
  if (!prog || document.hidden) return;
  frameNo++;
  if (now() - lastAction > 4 && frameNo % 10 !== 0) return;
  const t = now(), on = t < sim.signalUntil, base = hexToRgb(sim.color), odd = sim.kind === "done" ? oddGreen(sim.color) : oddBlue(sim.color);
  gl.uniform1f(uni.iTime, t); gl.uniform1f(uni.iTimeCursorChange, sim.change);
  gl.uniform4f(uni.iCurrentCursor, ...rect(ROW, sim.cur)); gl.uniform4f(uni.iPreviousCursor, ...rect(ROW + sim.prevRow, sim.prev));
  gl.uniform4f(uni.iCurrentCursorColor, ...(on ? odd : base), 1); gl.uniform4f(uni.iPreviousCursorColor, ...(sim.signalPrev ? odd : base), 1);
  gl.drawArrays(gl.TRIANGLES, 0, 3);
  const err = $("#previewErr"); if (err) { err.hidden = !previewError; if (previewError) err.textContent = t("compileErr") + previewError; }
}
requestAnimationFrame(frame);
let typing = null;
function moveCursor(col, row = 0) { sim.prev = sim.cur; sim.prevRow = row; sim.cur = col; sim.change = now(); lastAction = sim.change; drawTerm(); applyZoom(); }
function endSignal() { sim.signalPrev = true; sim.change = now(); sim.signalUntil = 0; later(() => { sim.signalPrev = false; }, 50); }
const MAX_INPUT = Math.floor((W - 2 * PADX) / CW) - 4;
// Typed or picked text goes in at once: one cursor move for a whole phrase, like the terminal.
function insertText(text) {
  clearTimeout(typing);
  for (const ch of Array.from(text.replace(/[\r\n]/g, ""))) { if (cellsOf(sim.input + ch) > MAX_INPUT) break; sim.input += ch; }
  moveCursor(2 + cellsOf(sim.input));
}
// The preview's Enter and done always start from the plain color (a real second signal while
// one is on also flips the red value's lowest bit; see `cursor-fx signal`).
const scenarios = {
  type() { clearTimeout(typing); const text = "make the cursor glow"; let i = 0; sim.input = ""; moveCursor(2); const step = () => { if (i >= text.length) return; sim.input += text[i++]; moveCursor(2 + cellsOf(sim.input)); typing = later(step, 130); }; typing = later(step, 130); },
  enter() { clearTimeout(typing); if (!sim.input) sim.input = "make it glow"; sim.sent = sim.input; sim.input = ""; moveCursor(2); later(() => { sim.kind = "enter"; sim.signalPrev = false; sim.signalUntil = now() + 1.9; sim.change = now(); sim.prev = sim.cur; sim.prevRow = 0; later(endSignal, 1900); }, 60); },
  done() { clearTimeout(typing); sim.kind = "done"; sim.signalPrev = false; sim.signalUntil = now() + 1.9; sim.change = now(); lastAction = sim.change; sim.prev = sim.cur; sim.prevRow = 0; later(endSignal, 1900); },
  deleteAll() { clearTimeout(typing); if (!sim.input) { sim.input = "delete all of this text"; moveCursor(2 + cellsOf(sim.input)); later(() => { sim.input = ""; moveCursor(2); }, 400); } else { sim.input = ""; moveCursor(2); } }
};
// Typing straight into the preview (it has focus): letters, Backspace, Cmd/Ctrl/Alt+Backspace, Enter.
// Keys an input method is using (pinyin and the like) are left to it: its text arrives at compositionend.
function previewKey(ev) {
  if (ev.isComposing || ev.keyCode === 229) return;
  if (ev.key === "Escape") { ev.currentTarget.blur(); return; }
  if (ev.key === "Enter") { ev.preventDefault(); scenarios.enter(); return; }
  if (ev.key === "Backspace") {
    ev.preventDefault(); clearTimeout(typing);
    if (ev.metaKey || ev.ctrlKey || ev.altKey) { if (sim.input) { sim.input = ""; moveCursor(2); } }
    else if (sim.input) { sim.input = Array.from(sim.input).slice(0, -1).join(""); moveCursor(2 + cellsOf(sim.input)); }
    return;
  }
  if (ev.key.length === 1 && !ev.metaKey && !ev.ctrlKey) {
    ev.preventDefault(); clearTimeout(typing);
    insertText(ev.key);
  }
}
// Zoom: the preview scaled up around the cursor (the canvas has more pixels than it is shown with).
function applyZoom() {
  const box = $("#previewBox"), z = box && box.querySelector(".pvzoom"); if (!z) return;
  const bw = box.clientWidth, k = bw / W, bh = H * k;
  const px = (PADX + (sim.cur + 0.5) * CW) * k, py = (PADY + (ROW + 0.5) * CH) * k;
  const tx = Math.min(0, Math.max(bw - bw * ZOOM, bw / 2 - px * ZOOM)), ty = Math.min(0, Math.max(bh - bh * ZOOM, bh / 2 - py * ZOOM));
  z.style.transform = ZOOM === 1 ? "none" : `translate(${tx}px, ${ty}px) scale(${ZOOM})`;
  // The (invisible) text field sits on the cursor, so the input method's candidates show next to it.
  const ime = box.querySelector("#ime");
  if (ime) { const zx = ZOOM === 1 ? 0 : tx, zy = ZOOM === 1 ? 0 : ty; ime.style.left = `${zx + (PADX + sim.cur * CW) * k * ZOOM}px`; ime.style.top = `${zy + (PADY + ROW * CH) * k * ZOOM}px`; ime.style.height = `${CH * k * ZOOM}px`; }
}
window.addEventListener("resize", applyZoom);

// --- the page ---------------------------------------------------------------
let selected = STATE.active !== "off" && STATE.effects.some(e => e.name === STATE.active) ? STATE.active : (STATE.effects[0] || {}).name;
const effectOf = name => STATE.effects.find(e => e.name === name);
const cap = s => s && LANG === "en" ? s[0].toUpperCase() + s.slice(1) : s;
// What an effect is, in a few words (an effect added later: its description up to the first pause).
const TAGLINES = {
  en: { cyber: "Data rain, glowing type", lightning: "Arcs of current", glitch: "A corrupted signal", neon: "A glowing pink tube",
        phosphor: "Green CRT glow", embers: "A burning coal", shockwave: "Ripples that bend text", katana: "A polished steel blade",
        teleport: "A transporter beam", fireworks: "Sparkler and fireworks", aurora: "Northern lights", mecha: "Robot armor", hologram: "A cyan projection" },
  zh: { cyber: "数据雨，文字烙印", lightning: "电弧与闪电", glitch: "受损的信号", neon: "粉色霓虹灯管", phosphor: "绿色 CRT 荧光", embers: "燃烧的炭火",
        shockwave: "让文字弯曲的波纹", katana: "抛光的钢刃", teleport: "传送光束", fireworks: "手持烟花与烟火", aurora: "北极光", mecha: "机甲装甲", hologram: "青色全息投影" } };
const taglineOf = e => TAGLINES[LANG][e.name] || cap((descOf(e) || "").split(/[;；。:：(（]/)[0].trim());
function renderList() {
  const el = $("#effects"); el.innerHTML = "";
  for (const e of STATE.effects) {
    const b = document.createElement("button"); b.type = "button"; b.className = "effect" + (e.name === selected ? " selected" : "");
    if (e.name === selected) b.setAttribute("aria-current", "true");
    b.innerHTML = `<span class="dot"></span><span class="name"></span>${e.name === STATE.active ? '<span class="badge"></span>' : ""}<span class="tag"></span>`;
    b.querySelector(".dot").style.background = e.color; b.querySelector(".name").textContent = cap(nameOf(e)); b.querySelector(".tag").textContent = taglineOf(e);
    if (b.querySelector(".badge")) b.querySelector(".badge").textContent = t("active");
    b.onclick = () => { if (selected === e.name) return; selected = e.name; renderList(); renderDetail(); for (const id of ["#knobs", "#detail", "#stage"]) { const el = $(id); if (el) el.scrollTop = 0; } };
    el.appendChild(b);
  }
  showSharedFlags();
}
// A header switch shared by every effect: on, off, or half-filled when the effects differ.
// Enter & done is off while the config still has the pause line of cursor-fx before 1.1.
function flagState(names) {
  const vals = new Set(STATE.effects.flatMap(e => names.map(n => (e.settings.find(s => s.name === n) || {}).value)).filter(Boolean).map(v => v.trim()));
  return vals.size === 1 ? (vals.has("true") ? "on" : "off") : vals.size ? "mixed" : "n/a";
}
const HEADER_FLAGS = [["#enterSwitch", ["ENTER_EFFECT", "DONE_EFFECT"]], ["#jumpsSwitch", ["JUMP_EFFECTS"]], ["#idleSwitch", ["IDLE_EFFECTS"]], ["#subtleSwitch", ["SUBTLE"]]];
function showSharedFlags() {
  for (const [id, names] of HEADER_FLAGS) {
    const st = id === "#enterSwitch" && STATE.enterPaused ? "off" : flagState(names), cb = $(id);
    cb.checked = st === "on"; cb.indeterminate = st === "mixed";
  }
}
const timers = {};
function debounce(key, ms, fn) { clearTimeout(timers[key]); timers[key] = setTimeout(fn, ms); }

// Every effect's settings come in the same sections, in this order (the `// -- Name` lines in
// its shader). A section's on/off switch sits in its title; IDLE_EFFECTS is the header's.
const SECTION_ORDER = ["Typing", "Enter & done", "Delete-all", "Cursor", "Prompt mark", "Box lines", "Your text", "Look", "Timing"];
const MASTER = { "Typing": "TYPE_EFFECT", "Delete-all": "JUMP_EFFECTS", "Cursor": "CURSOR_EFFECT", "Prompt mark": "PROMPT_EFFECT", "Your text": "TEXT_COLOR" };
const HIDDEN = new Set(["IDLE_EFFECTS"]);
// Settings that only act while the header's Idle animations switch is on.
const isIdleSetting = name => /^(IDLE|PING)_/.test(name);
// A setting that only does something while a switch is on fades (with a tooltip) while it's off.
const NEEDS = { LINE_COLOR: "LINE_TINT", LINE_STRENGTH: "LINE_EFFECT" };
function refreshNeeds(e) {
  for (const [child, parent] of Object.entries(NEEDS)) {
    const p = e.settings.find(x => x.name === parent), row = document.querySelector(`.setting[data-name="${child}"]`);
    if (!p || !row) continue;
    const off = (p.value || "").trim() === "false";
    row.classList.toggle("needoff", off); row.title = off ? t("needsOffTip", { name: labelFor(p) }) : "";
  }
}
const secTitle = g => UI[LANG]["sec_" + g] ?? UI.en["sec_" + g] ?? groupOf(g);
// A switch's note, read as a sentence: without "the cursor's own look:" and the like (the
// section title says it) and without command-line hints in parentheses.
const PREFIXES = [/^the cursor's own look:\s*/i, /^the prompt mark \(❯\) at the start of the cursor's line:\s*/i, /^the input box lines, always:\s*/i,
  /^光标自身的外观[：:]\s*/, /^(光标所在行开头的|行首的|光标所在行的)提示符（❯）[：:]\s*/, /^输入框(的)?(上下两条)?线条[，,]?\s*(始终|常驻)[^：:]*[：:]\s*/];
const plain = s => { s = s || ""; for (const p of PREFIXES) s = s.replace(p, ""); return s.replace(/\s*[（(][^()（）]*`[^()（）]*[）)]/g, "").replace(/\s*[（(]sRGB[）)]/g, "").trim(); };

// Redraws the selected effect, keeping the scroll position and the open "More settings"
// sections where they were (nothing on the page jumps).
function renderDetail() {
  const panes = ["#knobs", "#detail", "#stage"].map(id => [$(id), ($(id) || {}).scrollTop || 0]), y = window.scrollY;
  const open = new Set([...document.querySelectorAll("#knobs details[open]")].map(d => d.closest(".sec").dataset.group));
  renderDetailNow();
  document.querySelectorAll("#knobs .sec").forEach(s => { if (open.has(s.dataset.group)) { const d = s.querySelector("details"); if (d) d.open = true; } });
  for (const [el, top] of panes) if (el) el.scrollTop = top;
  window.scrollTo(0, y);
  typeReady();
}
function renderDetailNow() {
  const e = effectOf(selected); if (!e) return;
  clearTimeout(timers.compile);  // a recompile still waiting belongs to the effect shown before
  document.documentElement.style.setProperty("--accent", e.color);
  sim.color = e.color; usePreview(e.source); lastAction = now();
  const d = $("#stage"), k = $("#knobs"); d.innerHTML = ""; k.innerHTML = "";
  const card = document.createElement("div"); card.className = "card";
  const segs = (id, items, cur) => `<div class="seg small" id="${id}" role="radiogroup">${items.map(([v, l]) => `<button type="button" role="radio" data-v="${v}" class="${v === cur ? "on" : ""}">${l}</button>`).join("")}</div>`;
  card.innerHTML = `<div class="title"><h2></h2><div class="actions"><button class="primary" id="useBtn"></button><button id="resetBtn"></button></div></div><p class="desc"></p>
    <div class="preview" id="previewBox" tabindex="0" aria-label="${t("preview")}"><div class="pvzoom"></div><span class="kbd" id="kbdHint">${t("clickToType")}</span><pre class="err" id="previewErr" hidden></pre><textarea id="ime" class="ime" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="${t("preview")}"></textarea></div>
    <div class="pvbar"><div class="row"><button data-s="type">${t("sType")}</button><button data-s="enter">${t("sEnter")}</button><button data-s="done">${t("sDone")}</button><button data-s="deleteAll">${t("sDeleteAll")}</button></div>
      <div class="row pvopts"><span class="lbl">${t("zoom")}</span>${segs("zoomSeg", [[1, "1×"], [2, "2×"], [4, "4×"]], ZOOM)}<span class="lbl">${t("speed")}</span>${segs("speedSeg", [[1, "1×"], [0.5, "½×"], [0.25, "¼×"]], SPEED)}</div></div>
    <p class="hint">${t("previewHint")}</p>`;
  card.querySelector("h2").textContent = cap(nameOf(e)); card.querySelector(".desc").textContent = cap(descOf(e)); card.querySelector("#resetBtn").textContent = t("reset");
  const useBtn = card.querySelector("#useBtn"); useBtn.textContent = e.name === STATE.active ? t("inUse") : t("use"); useBtn.disabled = e.name === STATE.active;
  useBtn.onclick = async () => { try { const r = await post("/activate", { effect: e.name }); STATE.active = e.name; STATE.savepoint = r.savepoint; showUndo(); toast(t("switched", { effect: cap(nameOf(e)) })); renderList(); renderDetail(); } catch (err) { toast(t("errSwitch", { err: err.message }), "error"); } };
  // Reset asks first, in place of the two buttons.
  card.querySelector("#resetBtn").onclick = () => confirmInline(card.querySelector(".actions"),
    t(STATE.hasDefaults ? "resetAsk" : "resetAskOpen", { effect: cap(nameOf(e)) }), t("resetYes"), async () => {
      try { const r = await post("/reset", { effect: e.name }); await refresh(); toast(t(r.shipped ? "wasReset" : "wasResetOpen", { effect: cap(nameOf(e)) })); }
      catch (err) { toast(t("errReset", { err: err.message }), "error"); } });
  const box = card.querySelector("#previewBox"), hintEl = card.querySelector("#kbdHint");
  box.querySelector(".pvzoom").appendChild(cv);
  const ime = card.querySelector("#ime"), typeHere = () => ime.focus({ preventScroll: true });
  box.addEventListener("mousedown", ev => { ev.preventDefault(); typeHere(); });
  box.addEventListener("focus", typeHere);
  ime.addEventListener("keydown", previewKey);
  ime.addEventListener("compositionupdate", ev => { sim.preedit = ev.data || ""; lastAction = now(); drawTerm(); });
  ime.addEventListener("compositionend", ev => { sim.preedit = ""; ime.value = ""; if (ev.data) insertText(ev.data); else drawTerm(); });
  ime.addEventListener("input", ev => { if (ev.isComposing) return; const v = ime.value; ime.value = ""; if (v) insertText(v); });
  ime.addEventListener("focus", () => { hintEl.textContent = t("typing"); box.classList.add("focused"); });
  ime.addEventListener("blur", () => { hintEl.textContent = t("clickToType"); box.classList.remove("focused"); if (sim.preedit) { sim.preedit = ""; drawTerm(); } });
  card.querySelectorAll("[data-s]").forEach(b => b.onclick = () => { scenarios[b.dataset.s](); typeHere(); });
  const pickSeg = (id, fn) => card.querySelectorAll(`#${id} button`).forEach(b => b.onclick = () => {
    card.querySelectorAll(`#${id} button`).forEach(x => x.classList.toggle("on", x === b)); fn(Number(b.dataset.v)); typeHere(); });
  pickSeg("zoomSeg", v => { ZOOM = v; applyZoom(); });
  pickSeg("speedSeg", v => setSpeed(v));
  d.appendChild(card);
  requestAnimationFrame(applyZoom);
  // The sections.
  const groups = new Map();
  for (const s of e.settings) {
    if (HIDDEN.has(s.name)) continue;
    const g = s.group || "Other";
    if (!groups.has(g)) groups.set(g, { main: [], fine: [] });
    groups.get(g)[s.section === "fine" ? "fine" : "main"].push(s);
  }
  if (!groups.has("Cursor")) groups.set("Cursor", { main: [], fine: [] });
  const names = [...SECTION_ORDER.filter(g => groups.has(g)), ...[...groups.keys()].filter(g => !SECTION_ORDER.includes(g))];
  for (const g of names) k.appendChild(sectionEl(e, g, groups.get(g)));
  k.insertAdjacentHTML("beforeend", `<p class="hint">${t("sizesHint")}</p>`);
}
function sectionEl(e, g, { main, fine }) {
  const sec = document.createElement("section"); sec.className = "sec"; sec.dataset.group = g;
  const head = document.createElement("div"); head.className = "sechead";
  const h = document.createElement("h3"); h.textContent = secTitle(g); head.appendChild(h); sec.appendChild(head);
  const master = MASTER[g] && main.find(s => s.name === MASTER[g]);
  if (master) {
    // The section's on/off switch, and its "was … ↺", sit in the title.
    const row = settingRow(e, master, { markEl: head, onValue: v => sec.classList.toggle("off", !v) });
    const ctl = row.querySelector(".control"); ctl.querySelector("input").setAttribute("aria-label", secTitle(g));
    head.appendChild(row.querySelector(".was")); head.appendChild(ctl);
  }
  const text = master ? plain(helpOf(master)) : (UI[LANG]["secd_" + g] ?? UI.en["secd_" + g]);
  if (text) { const p = document.createElement("p"); p.className = "secdesc"; p.textContent = cap(text); sec.appendChild(p); }
  const body = document.createElement("div"); body.className = "group";
  if (g === "Cursor") { body.appendChild(colorRow(e)); body.appendChild(blinkRow(e)); }
  for (const s of main) if (s !== master) body.appendChild(settingRow(e, s));
  // A lone extra setting in a section that shows nothing else isn't folded away behind "More settings (1)".
  if (!body.children.length && fine.length === 1) { body.appendChild(settingRow(e, fine[0])); fine = []; }
  if (body.children.length) sec.appendChild(body);
  if (fine.length) {
    const det = document.createElement("details"); det.className = "more";
    det.innerHTML = `<summary>${t("more", { n: fine.length })}</summary>`;
    const fg = document.createElement("div"); fg.className = "group";
    for (const s of fine) fg.appendChild(settingRow(e, s));
    det.appendChild(fg); sec.appendChild(det);
  }
  return sec;
}
// The cursor color (from the effect's preset) and whether it blinks, as rows of the Cursor section.
function colorRow(e) {
  const row = document.createElement("div"); row.className = "setting";
  row.innerHTML = `<label for="colorHex"></label><div class="control"><span class="contrast" id="contrast"></span><input type="color" id="colorPick" aria-label="${t("cursorColor")}"><input type="text" id="colorHex" maxlength="7" spellcheck="false"></div><div class="foot"><div class="help"></div></div>`;
  row.querySelector("label").textContent = t("cursorColor"); row.querySelector(".help").textContent = t("contrastHint");
  const pick = row.querySelector("#colorPick"), hex = row.querySelector("#colorHex"), ctr = row.querySelector("#contrast");
  const showContrast = c => { const r = contrast(c, STATE.colors.background); ctr.innerHTML = `<b>${r.toFixed(1)}:1</b> ${t("contrastOn", { bg: STATE.colors.background })}`; };
  pick.value = e.color; hex.value = e.color; showContrast(e.color);
  const applyColor = c => { if (!/^#[0-9a-fA-F]{6}$/.test(c)) return; pick.value = c; hex.value = c; showContrast(c); sim.color = c; drawTerm(); document.documentElement.style.setProperty("--accent", c);
    setSaving();
    debounce("color", 300, async () => { try { const r = await post("/color", { effect: e.name, color: c }); e.color = r.color; sim.color = r.color; hex.value = r.color; pick.value = r.color; STATE.savepoint = r.savepoint; showUndo(); renderList(); setStatus("saved", t("savedColor", { color: r.color })); } catch (err) { setStatus("error", t("errColor", { err: err.message })); } }); };
  pick.oninput = () => applyColor(pick.value); hex.onchange = () => applyColor(hex.value.startsWith("#") ? hex.value : "#" + hex.value);
  return row;
}
function blinkRow(e) {
  const row = document.createElement("div"); row.className = "setting";
  row.innerHTML = `<label for="blinkSwitch"></label><div class="control"><label class="switch"><input type="checkbox" id="blinkSwitch"> <span class="state"></span></label></div><div class="foot"><div class="help"></div></div>`;
  row.querySelector("label").textContent = t("blinks"); row.querySelector(".help").textContent = t("blinkHint");
  const blink = row.querySelector("#blinkSwitch"), st = row.querySelector(".state");
  const show = () => { blink.checked = e.blink; st.textContent = t(e.blink ? "on" : "off"); }; show();
  blink.onchange = async () => { setSaving(); try { const r = await post("/blink", { effect: e.name, on: blink.checked }); e.blink = r.blink; STATE.savepoint = r.savepoint; showUndo(); show(); setStatus("saved", t(r.blink ? "savedBlinkOn" : "savedBlinkOff", { effect: cap(nameOf(e)) })); } catch (err) { show(); setStatus("error", t("errBlink", { err: err.message })); } };
  return row;
}
// A row's label and note: the panel's own words for the shared switches, the shader's otherwise.
const labelFor = s => UI[LANG]["label_" + s.name] ?? (LANG === "en" ? UI.en["label_" + s.name] : undefined) ?? labelOf(s);
const noteOf = (s, help) => UI[LANG]["hint_" + s.name] ?? cap(plain(noteFor(help, s.group)));
// One setting: a control, the value, a mark when it differs from the value the
// panel opened with (and a button back to it). Edits recompile the preview a
// moment after the last change and save a moment after that; nothing that
// fails to compile is saved. opts.markEl gets the changed mark instead of the row
// (a section title), opts.onValue hears every value (a section dims when off).
function settingRow(e, s, opts = {}) {
  const row = document.createElement("div"); row.className = "setting"; row.dataset.name = s.name;
  const label = document.createElement("label"); label.textContent = labelFor(s); label.title = s.name; row.appendChild(label);
  const ctl = document.createElement("div"); ctl.className = "control"; row.appendChild(ctl);
  const original = ((STATE.original[e.name] || {}).settings || {})[s.name];
  let value = parseValue(s.type, s.value);
  const choices = s.type === "int" ? choicesOf(s) : null;
  const shown = v => s.type === "bool" ? t(String(v).trim() === "true" ? "on" : "off")
    : choices ? (choices.items.find(([k]) => k === Number(v)) || [0, v])[1] : v;
  const was = document.createElement("span"); was.className = "was";
  const markChanged = () => { const changed = original !== undefined && s.value !== original; (opts.markEl || row).classList.toggle("changed", changed); row.classList.toggle("changed", changed); if (!was.firstChild && original !== undefined) { was.innerHTML = `${t("was", { value: shown(original) })}<button type="button">↺</button>`; was.querySelector("button").onclick = () => { value = parseValue(s.type, original); setControls(); commit(); }; } };
  let setControls = () => {};
  const commit = () => {
    const source = glsl(s.type, value); if (source === s.value) return;
    const prevSource = e.source, prevValue = s.value;
    s.value = source; e.source = patchSource(e.source, s.name, source); markChanged(); refreshNeeds(e);
    debounce("compile", 120, () => { if (selected === e.name) { usePreview(e.source); lastAction = now(); } });
    setSaving();
    debounce("set:" + e.name + ":" + s.name, 320, async () => {
      // Judge this effect's own source (the preview may show another effect by now).
      if (!compiles(e.source)) { e.source = prevSource; s.value = prevValue; value = parseValue(s.type, prevValue); setControls(); markChanged(); if (selected === e.name) usePreview(e.source); setStatus("error", t("noCompile")); return; }
      try {
        const r = await post("/set", { effect: e.name, name: s.name, type: s.type, value }); STATE.savepoint = r.savepoint; showUndo();
        if (r.source !== s.value) {  // the server kept it inside the setting's range
          s.value = r.source; e.source = patchSource(e.source, s.name, r.source); value = parseValue(s.type, r.source); setControls(); markChanged();
          if (selected === e.name) usePreview(e.source);
        }
        if ((STATE.sharedFlags || []).includes(s.name)) showSharedFlags();
        setStatus("saved", t("savedSetting", { name: opts.markEl ? secTitle(s.group) : labelFor(s), value: shown(r.source) }));
      }
      catch (err) { setStatus("error", t("errSave", { name: labelFor(s), err: err.message })); }
    });
  };
  if (choices) {
    row.classList.add("choice");
    const seg = document.createElement("div"); seg.className = "seg"; seg.setAttribute("role", "radiogroup"); seg.setAttribute("aria-label", labelFor(s));
    const btns = choices.items.map(([v, name]) => {
      const b = document.createElement("button"); b.type = "button"; b.textContent = name; b.setAttribute("role", "radio");
      b.onclick = () => { if (value === v) return; value = v; setControls(); commit(); };
      seg.appendChild(b); return [v, b];
    });
    setControls = () => btns.forEach(([v, b]) => { b.classList.toggle("on", v === value); b.setAttribute("aria-checked", v === value); });
    ctl.appendChild(seg);
  } else if (s.type === "bool") {
    const sw = document.createElement("label"); sw.className = "switch"; sw.innerHTML = `<input type="checkbox"> <span class="state"></span>`;
    const cb = sw.querySelector("input"), txt = sw.querySelector(".state"); cb.setAttribute("aria-label", labelFor(s));
    setControls = () => { cb.checked = value; txt.textContent = t(value ? "on" : "off"); if (opts.onValue) opts.onValue(value); };
    cb.onchange = () => { value = cb.checked; setControls(); commit(); }; ctl.appendChild(sw);
  } else if (s.type === "float" || s.type === "int") {
    // The range comes from the panel's server (the setting's note and its shipped default), the
    // same one it saves with; a value already outside it still shows.
    const lim = s.limits || { min: 0, max: Math.max(1, Math.abs(value) * 3), step: 0.01, int: s.type === "int" };
    const range = document.createElement("input"); range.type = "range"; range.min = Math.min(lim.min, value); range.max = Math.max(lim.max, value); range.step = lim.step; range.setAttribute("aria-label", labelFor(s));
    const num = document.createElement("input"); num.type = "number"; num.step = lim.step; num.min = lim.min; num.max = lim.max; num.className = "val"; num.setAttribute("aria-label", labelFor(s));
    setControls = () => { range.value = value; num.value = value; };
    range.oninput = () => { value = Number(range.value); num.value = value; commit(); };
    num.onchange = () => { let v = Number(num.value); if (num.value.trim() === "" || !isFinite(v)) { setControls(); return; } v = Math.min(Math.max(v, lim.min), lim.max); value = lim.int ? Math.round(v) : v; setControls(); commit(); };
    ctl.appendChild(range); ctl.appendChild(num);
  } else if (s.type === "vec3") {
    const pick = document.createElement("input"); pick.type = "color"; pick.setAttribute("aria-label", labelFor(s));
    const hex = document.createElement("input"); hex.type = "text"; hex.maxLength = 7;
    setControls = () => { pick.value = rgbToHex(value); hex.value = pick.value; };
    const set = c => { if (!/^#[0-9a-fA-F]{6}$/.test(c)) return; value = hexToRgb(c); setControls(); commit(); };
    pick.oninput = () => set(pick.value); hex.onchange = () => set(hex.value.startsWith("#") ? hex.value : "#" + hex.value);
    ctl.appendChild(pick); ctl.appendChild(hex);
  } else {
    const nums = value.map((v, i) => { const num = document.createElement("input"); num.type = "number"; num.step = 0.05; num.onchange = () => { const n = Number(num.value); if (isFinite(n)) { value[i] = n; commit(); } }; ctl.appendChild(num); return num; });
    setControls = () => nums.forEach((num, i) => num.value = value[i]);
  }
  setControls(); markChanged();
  const foot = document.createElement("div"); foot.className = "foot";
  const help = document.createElement("div"); help.className = "help"; help.textContent = noteOf(s, choices ? choices.help : helpOf(s)) || "";
  foot.appendChild(help); foot.appendChild(was); row.appendChild(foot);
  // Idle settings do nothing while this effect's idle animations are off (the header switch).
  if (isIdleSetting(s.name) && ((e.settings.find(x => x.name === "IDLE_EFFECTS") || {}).value || "").trim() === "false") { row.classList.add("idleoff"); row.title = t("idleOffTip"); }
  const need = NEEDS[s.name] && e.settings.find(x => x.name === NEEDS[s.name]);
  if (need && (need.value || "").trim() === "false") { row.classList.add("needoff"); row.title = t("needsOffTip", { name: labelFor(need) }); }
  return row;
}
function setSaving() { setStatus("saving", t("saving")); }
function setStatus(kind, text) {
  const el = $("#status"); el.className = "pill " + (kind || "");
  if (!kind) text = t("live");
  const full = kind === "saved" ? text + " · " + new Date().toLocaleTimeString(LANG === "zh" ? "zh-CN" : undefined) : text;
  el.innerHTML = "<span></span>"; el.firstChild.textContent = full; el.title = full;
  if (kind === "saved") { clearTimeout(timers.status); timers.status = setTimeout(() => setStatus(), 6000); }
}
async function refresh() { STATE = await post("/state"); renderList(); renderDetail(); setStatus(); showUndo(); }
// The header's switches for every effect at once (each writes its constants into every shader).
for (const [id, what, key] of [["#enterSwitch", "enter", "enterSw"], ["#jumpsSwitch", "jumps", "jumpsSw"], ["#idleSwitch", "idle", "idleSw"], ["#subtleSwitch", "subtle", "subtleSw"]]) {
  $(id).onchange = async ev => {
    const on = ev.target.checked;
    try { await post("/toggle", { what, on }); await refresh(); toast(t("toggled", { what: t(key), state: t(on ? "on" : "off") })); }
    catch (err) { showSharedFlags(); toast(err.message, "error"); }
  };
}
$("#undoBtn").onclick = async () => {
  clearTimeout(undoTimer);
  if (!undoArmed) {
    undoArmed = true; showUndo(); setStatus("ask", t("undoAsk"));
    undoTimer = setTimeout(() => { undoArmed = false; showUndo(); setStatus(); }, 6000);
    return;
  }
  undoArmed = false; showUndo(); setSaving();
  try { await post("/undo"); await refresh(); toast(t("undone")); }
  catch (err) { toast(t("errUndo", { err: err.message }), "error"); }
};
$("#doneBtn").onclick = async () => { try { await post("/quit"); } catch (err) {} document.body.innerHTML = `<p style="padding:40px;color:var(--text)">${t("closed")}</p>`; };
$("#langBtn").onclick = () => { LANG = LANG === "zh" ? "en" : "zh"; try { localStorage.setItem("cursor-fx-lang", LANG); } catch (e) {} applyLang(); renderList(); renderDetail(); setStatus(); };
// Typing always goes to the preview: its text field takes the focus back after any click
// or switch, unless a text or number field (a value, a color) is being edited. A key pressed
// while something else has the focus (a button, a slider) is passed on to the preview too.
const isField = el => !!el && !!el.matches && el.matches('input[type=text], input[type=number], input[type=color], input[type=range]');
function typeReady() {
  const ime = $("#ime"), a = document.activeElement;
  if (!ime || a === ime || isField(a) || document.hidden || !document.hasFocus()) return;
  // Text the user selected (to copy a note, say) stays selected: taking the focus would drop it.
  const sel = window.getSelection();
  if (sel && !sel.isCollapsed && sel.toString().trim()) return;
  ime.focus({ preventScroll: true });
}
document.addEventListener("pointerup", () => setTimeout(typeReady, 0));
document.addEventListener("change", ev => { if (!isField(ev.target)) setTimeout(typeReady, 0); });
window.addEventListener("focus", () => setTimeout(typeReady, 0));
document.addEventListener("keydown", ev => {
  const ime = $("#ime"), tgt = ev.target;
  if (!ime || tgt === ime || ev.isComposing) return;
  if (isField(tgt) && !(tgt.type === "range" && ev.key.length === 1 && ev.key !== " ")) return;
  if (ev.key === "Tab" || ev.key === "Escape" || ev.key.startsWith("Arrow") || (ev.metaKey && ev.key !== "Backspace") || ev.ctrlKey && ev.key !== "Backspace") return;
  const onControl = tgt && tgt.matches && tgt.matches("button, summary, label, input[type=checkbox]");
  if ((ev.key === "Enter" || ev.key === " ") && onControl) return;  // those press the control
  if (ev.key.length === 1 || ev.key === "Backspace" || ev.key === "Enter" || ev.keyCode === 229) {
    ime.focus({ preventScroll: true });
    if (ev.keyCode !== 229) previewKey(ev);
  }
}, true);
applyLang(); renderList(); renderDetail(); setStatus();
</script>
</body>
</html>
"""


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if len(argv) > 1 and argv[1] in ("-V", "--version", "version"):
        print(f"cursor-fx {VERSION}")
        return 0
    if len(argv) == 4 and argv[1] == "_keep-save":   # install.sh, before copying a new version in
        return keep_save(argv[2], argv[3])
    if len(argv) == 4 and argv[1] == "_keep-apply":  # install.sh, after copying it
        return keep_apply(argv[2], argv[3])
    if len(argv) > 1 and argv[1] == "signal-off":
        return signal_off(*argv[2:5])
    if len(argv) > 1 and argv[1] == "signal":
        try:
            return signal_enter(argv)
        except Exception:  # a hook must never fail loudly
            return 0
    if len(argv) > 1 and argv[1] == "config-path":
        print(CONFIG)
        return 0
    if not os.path.isfile(CONFIG):
        print(f"Ghostty config not found: {CONFIG}")
        return 1
    if len(argv) == 1:
        return list_effects()
    if argv[1] == "_switches":  # install.sh, after copying the shaders
        report_switches(sync_switches())
        return 0
    if argv[1] == "toggle":
        return toggle()
    if argv[1] == "panes":
        return set_panes(argv[2] if len(argv) > 2 else None)
    if argv[1] in FLAGS:
        return set_flag(argv[1], argv[2] if len(argv) > 2 else None)
    if argv[1] == "edit":
        return edit_panel(open_browser="--no-open" not in argv)
    name = argv[1][:-5] if argv[1].endswith(".conf") else argv[1]  # (no str.removesuffix: Python 3.8 still works)
    return switch(name)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
